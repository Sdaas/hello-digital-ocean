#!/usr/bin/env bash
#
# digital-ocean — control CLI for the DigitalOcean demo host.
#
# This is the MAIN ARTIFACT of the hello-digital-ocean repo: a Mac-side control
# CLI that provisions and tears down the DigitalOcean infrastructure (droplets +
# volumes) and runs the reference "demo" app on it — e.g. `digital-ocean start`,
# `digital-ocean stop`, `digital-ocean setup`, `digital-ocean destroy`,
# `digital-ocean local`. The cloud subcommands are added by later features
# (F4–F9); F3 ships the first real subcommand, `local`, plus the subcommand
# dispatcher those siblings build on.
#
# Written to run under both bash and zsh: avoids bash-only features
# (no arrays, no ${BASH_SOURCE}). Keep it that way.

set -eu

# --- Paths (portable: derive from $0, no ${BASH_SOURCE}) --------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Where `local` keeps its runtime state (pid + captured app log). Overridable so
# tests can point it at a throwaway dir. Defaults to the LOCAL data dir.
STATE_DIR="${DO_LOCAL_STATE_DIR:-$REPO_ROOT/demo/.localdata}"
PID_FILE="$STATE_DIR/local.pid"
LOG_FILE="$STATE_DIR/local.log"

# The venv `local` builds from demo/requirements.txt (the SAME manifest that
# ships to DO — proving one dependency set runs in both places, UC7).
VENV="$REPO_ROOT/.venv"

# The demo app binds here under APP_ENV=LOCAL (config.py: 127.0.0.1:5000).
LOCAL_URL="http://127.0.0.1:5000"
# Local Ollama endpoint (matches the demo app's OLLAMA_URL default).
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"

# Where `setup` (F4) writes the local config. Repo-local and gitignored;
# overridable so tests point it at a throwaway dir. The cloud commands (F6/F7)
# read this file. Env-style KEY=value (sourceable — no jq dependency).
CONFIG_DIR="${DO_CONFIG_DIR:-$REPO_ROOT/.do}"
CONFIG_FILE="$CONFIG_DIR/config"
# Where `provision`/`deprovision` (F6) record the DO resource state (VPC, volume,
# droplet IDs + IPs). Same dir/discipline as the config: repo-local, gitignored,
# written 0600, sourceable env-style KEY=value. F7/F8/F9 read this file.
DO_STATE_FILE="$CONFIG_DIR/state"

# --- Logging (see design/overview.md) ---------------------------------------
# Leveled logging to STDERR so stdout carries only real output/data. Two levels
# the user selects: INFO (default) and DEBUG (via --verbose); ERROR is always
# emitted. Each line is "<ISO-8601 UTC> <LEVEL> digital-ocean: <message>".
LOG_LEVEL=INFO

log() { # log LEVEL message...
	level="$1"
	shift
	# DEBUG lines only appear when the user asked for --verbose.
	if [ "$level" = DEBUG ] && [ "$LOG_LEVEL" != DEBUG ]; then
		return 0
	fi
	printf '%s %s digital-ocean: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$level" "$*" >&2
}
log_debug() { log DEBUG "$@"; }
log_info() { log INFO "$@"; }
log_error() { log ERROR "$@"; }

usage() {
	cat <<EOF
Usage: digital-ocean [--help] [--verbose] [<command>]

Control CLI for the DigitalOcean demo host — provisions/tears down the DO
infrastructure and runs the reference "demo" app on it.

Commands:
  setup            One-time local preflight + interview → write local config.
  setup --non-interactive   Same, no prompts (accept defaults / env overrides).
  local            Run the demo app on this Mac (venv + Flask + browser).
  local down       Stop the locally running demo app.
  start            Provision DO infra + deploy the demo end-to-end (BILLABLE);
                   prints the public URL and ssh commands when healthy.

Other cloud commands (stop/destroy/ssh/logs/status) are added in later features.
With no command, prints a short banner.
EOF
}

# --- `digital-ocean local` (F3) ---------------------------------------------

# Reachable if the local Ollama server answers /api/tags. Used as an `if`
# condition, so a non-zero curl doesn't trip `set -e`.
_ollama_reachable() {
	curl -fsS --max-time 2 "$OLLAMA_URL/api/tags" >/dev/null 2>&1
}

# True while pid $1 exists.
_alive() {
	[ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

# Poll the app's /health until it answers 200, up to ~15s.
_wait_health() {
	tries=0
	while [ "$tries" -lt 30 ]; do
		if curl -fsS --max-time 1 "$LOCAL_URL/health" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.5
		tries=$((tries + 1))
	done
	return 1
}

# Open the app in a browser, unless suppressed or unavailable.
_open_browser() {
	if [ "${DO_LOCAL_NO_BROWSER:-}" = "1" ]; then
		log_info "browser open skipped (DO_LOCAL_NO_BROWSER=1)"
	elif command -v open >/dev/null 2>&1; then
		open "$LOCAL_URL" || log_error "could not open a browser at $LOCAL_URL"
	else
		log_info "open $LOCAL_URL in your browser"
	fi
}

cmd_local() {
	# `local down` is the teardown; everything else must be empty.
	if [ "${1:-}" = "down" ]; then
		cmd_local_down
		return $?
	fi
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'local': $1"
		usage >&2
		return 2
	fi

	# Already running? Re-open the browser rather than starting a second copy.
	if [ -f "$PID_FILE" ]; then
		running="$(cat "$PID_FILE" 2>/dev/null || true)"
		if _alive "$running"; then
			log_info "digital-ocean local already running (pid $running)."
			_open_browser
			echo "$LOCAL_URL"
			return 0
		fi
		log_debug "removing stale pid file (pid $running no longer alive)"
		rm -f "$PID_FILE"
	fi

	# Fail fast if Ollama is down — before building a venv, so we don't do a
	# pointless pip install when the model backend isn't even up.
	if ! _ollama_reachable; then
		log_error "Ollama is not reachable at $OLLAMA_URL."
		log_error "Start it first, then re-run:  ollama serve"
		return 1
	fi

	# Ensure a venv from the SAME demo/requirements.txt that ships to DO.
	if [ ! -x "$VENV/bin/python" ]; then
		if ! command -v python3 >/dev/null 2>&1; then
			log_error "python3 not found — install Python 3 to run the demo app."
			return 1
		fi
		log_info "Creating venv at $VENV"
		if ! python3 -m venv "$VENV"; then
			log_error "failed to create venv at $VENV"
			return 1
		fi
	fi
	log_info "Installing demo app dependencies (demo/requirements.txt)"
	if ! PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV/bin/python" -m pip install -q -r "$REPO_ROOT/demo/requirements.txt"; then
		log_error "pip install failed"
		return 1
	fi

	# Launch Flask detached with APP_ENV=LOCAL; capture output to the log file
	# and record the pid so `local down` can stop it.
	mkdir -p "$STATE_DIR"
	log_info "Starting demo app (APP_ENV=LOCAL) — logs at $LOG_FILE"
	APP_ENV=LOCAL "$VENV/bin/python" "$REPO_ROOT/demo/app.py" >"$LOG_FILE" 2>&1 &
	app_pid=$!
	echo "$app_pid" >"$PID_FILE"

	# Not healthy = not Done. Wait for /health, else tear down and report.
	if ! _wait_health; then
		log_error "demo app did not become healthy — see $LOG_FILE"
		kill "$app_pid" 2>/dev/null || true
		rm -f "$PID_FILE"
		return 1
	fi

	log_info "demo app healthy at $LOCAL_URL (pid $app_pid)"
	_open_browser
	# stdout carries the URL only (data), per the logging convention.
	echo "$LOCAL_URL"
}

cmd_local_down() {
	if [ ! -f "$PID_FILE" ]; then
		echo "digital-ocean local: not running."
		return 0
	fi
	pid="$(cat "$PID_FILE" 2>/dev/null || true)"
	if _alive "$pid"; then
		log_info "Stopping demo app (pid $pid)."
		kill "$pid" 2>/dev/null || true
		# Give it a moment to exit; escalate if it clings on.
		tries=0
		while _alive "$pid" && [ "$tries" -lt 20 ]; do
			sleep 0.2
			tries=$((tries + 1))
		done
		if _alive "$pid"; then
			log_debug "pid $pid still alive; sending SIGKILL"
			kill -9 "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
		echo "digital-ocean local: stopped."
	else
		rm -f "$PID_FILE"
		echo "digital-ocean local: not running (removed stale pid file)."
	fi
	return 0
}

# --- `digital-ocean setup` (F4) ---------------------------------------------
# Local-only: preflight checks, an interview (skippable with --non-interactive),
# and a write of the local config file. Creates ZERO billable resources — the
# only DO calls are read-only (`doctl account get`, `compute ssh-key list`).

# Emit a `KEY='value'` config line with POSIX-safe single-quote escaping, so a
# value containing a quote can't corrupt the file or break the next run's source.
_kv() { # key value
	esc="$(printf '%s' "$2" | sed "s/'/'\\\\''/g")"
	printf "%s='%s'\n" "$1" "$esc"
}

# Report a required local tool. Missing tools accumulate into _setup_fail.
_check_tool() { # name install-hint
	if command -v "$1" >/dev/null 2>&1; then
		log_info "preflight: $1 found"
	else
		log_error "preflight: $1 not found — $2"
		_setup_fail=1
	fi
}

# Resolve the local SSH private key. DO_SSH_KEY_FILE, when set, is authoritative
# (used exactly, no fallback) so tests are deterministic; otherwise scan the
# usual ~/.ssh candidates. Echoes the path; non-zero if none found.
_local_ssh_key() {
	if [ -n "${DO_SSH_KEY_FILE:-}" ]; then
		printf '%s' "$DO_SSH_KEY_FILE"
		return 0
	fi
	for f in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa"; do
		if [ -f "$f" ]; then
			printf '%s' "$f"
			return 0
		fi
	done
	return 1
}

# Resolve one config field. Precedence: explicit env override > (already-sourced)
# stored config / hardcoded default. Prompts only when interactive and no env
# override was given. Echoes the chosen value.
_field() { # envval default label
	if [ -n "$1" ]; then
		printf '%s' "$1"
		return 0
	fi
	if [ "$NONINTERACTIVE" = 1 ]; then
		printf '%s' "$2"
		return 0
	fi
	printf '%s [%s]: ' "$3" "$2" >&2
	if IFS= read -r reply && [ -n "$reply" ]; then
		printf '%s' "$reply"
	else
		printf '%s' "$2"
	fi
}

cmd_setup() {
	NONINTERACTIVE=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--non-interactive | -y)
			NONINTERACTIVE=1
			shift
			;;
		*)
			log_error "unknown argument to 'setup': $1"
			usage >&2
			return 2
			;;
		esac
	done

	# Capture explicit env overrides BEFORE sourcing the stored config (which
	# would otherwise clobber them).
	env_region="${DO_REGION:-}"
	env_cpu="${DO_CPU_SIZE:-}"
	env_gpu="${DO_GPU_SIZE:-}"
	env_backend="${OLLAMA_BACKEND:-}"
	env_ollama_cpu="${DO_OLLAMA_CPU_SIZE:-}"
	env_enable_fw="${DO_ENABLE_FIREWALL:-}"
	env_model="${OLLAMA_MODEL:-}"
	env_keyname="${DO_SSH_KEY_NAME:-}"
	env_creds="${APP_CREDENTIALS_FILE:-}"

	# --- preflight (accumulate ALL failures, then hard-fail) ----------------
	log_info "Running preflight checks (local only — nothing is provisioned)."
	_setup_fail=0
	_check_tool doctl "install doctl: https://docs.digitalocean.com/reference/doctl/how-to/install/"
	_check_tool ssh "install OpenSSH (ssh)"
	_check_tool scp "install OpenSSH (scp)"
	_check_tool curl "install curl"

	# DO auth + a registered key — only worth probing when doctl is present.
	do_key_name=""
	if command -v doctl >/dev/null 2>&1; then
		if doctl account get >/dev/null 2>&1; then
			log_info "preflight: DigitalOcean auth OK (doctl account get)"
		else
			log_error "preflight: doctl is not authenticated — run: doctl auth init"
			_setup_fail=1
		fi
		do_key_name="$(doctl compute ssh-key list --format Name --no-header 2>/dev/null | head -n1)"
		if [ -n "$do_key_name" ]; then
			log_info "preflight: DO-registered SSH key '$do_key_name'"
		else
			log_error "preflight: no DO-registered SSH key — import one: doctl compute ssh-key import <name> --public-key-file ~/.ssh/id_ed25519.pub"
			_setup_fail=1
		fi
	fi

	# Local SSH private key.
	keyfile="$(_local_ssh_key || true)"
	if [ -n "$keyfile" ] && [ -f "$keyfile" ]; then
		log_info "preflight: local SSH key $keyfile"
	else
		log_error "preflight: no local SSH key found — generate one: ssh-keygen -t ed25519"
		_setup_fail=1
	fi

	if [ "$_setup_fail" -ne 0 ]; then
		log_error "preflight failed — fix the items above and re-run 'digital-ocean setup'. No config written."
		return 1
	fi
	log_info "preflight passed."

	# --- interview ----------------------------------------------------------
	# Source any existing config so its values seed the interview defaults.
	if [ -f "$CONFIG_FILE" ]; then
		log_debug "loading existing config $CONFIG_FILE"
		# shellcheck disable=SC1090
		. "$CONFIG_FILE"
	fi

	region="$(_field "$env_region" "${DO_REGION:-ams3}" "DigitalOcean region")"
	cpu="$(_field "$env_cpu" "${DO_CPU_SIZE:-s-2vcpu-4gb}" "CPU droplet size")"
	gpu="$(_field "$env_gpu" "${DO_GPU_SIZE:-gpu-4000adax1-20gb}" "GPU droplet size")"
	# Ollama backend (#18): cpu (default — cheap, no GPU) or gpu. In cpu mode the
	# Ollama node is a CPU droplet of DO_OLLAMA_CPU_SIZE instead of a GPU droplet.
	backend="$(_field "$env_backend" "${OLLAMA_BACKEND:-cpu}" "Ollama backend (cpu|gpu)")"
	ollama_cpu="$(_field "$env_ollama_cpu" "${DO_OLLAMA_CPU_SIZE:-s-8vcpu-16gb-amd}" "CPU Ollama node size")"
	# DO cloud firewall (#19): optional. Ollama is kept off the public net by the
	# private-IP bind, so the firewall is defense-in-depth — default off (0).
	enable_fw="$(_field "$env_enable_fw" "${DO_ENABLE_FIREWALL:-0}" "Enable DO firewall (0|1)")"
	model="$(_field "$env_model" "${OLLAMA_MODEL:-llama3.2:1b}" "Ollama model")"
	key_name="$(_field "$env_keyname" "${DO_SSH_KEY_NAME:-$do_key_name}" "DO SSH key name")"
	creds="$(_field "$env_creds" "${APP_CREDENTIALS_FILE:-$CONFIG_DIR/credentials}" "Local credentials file")"

	# Ensure the credentials file exists (may be empty — ADR-0005).
	credsdir="$(dirname "$creds")"
	mkdir -p "$credsdir"
	[ -f "$creds" ] || : >"$creds"

	# --- write config (atomic, private perms) -------------------------------
	mkdir -p "$CONFIG_DIR"
	old_umask="$(umask)"
	umask 077
	tmp="$CONFIG_FILE.tmp.$$"
	{
		printf '# digital-ocean config — written by "digital-ocean setup" (F4). Gitignored; do not commit.\n'
		_kv DO_REGION "$region"
		_kv DO_CPU_SIZE "$cpu"
		_kv DO_GPU_SIZE "$gpu"
		_kv OLLAMA_BACKEND "$backend"
		_kv DO_OLLAMA_CPU_SIZE "$ollama_cpu"
		_kv DO_ENABLE_FIREWALL "$enable_fw"
		_kv OLLAMA_MODEL "$model"
		_kv DO_SSH_KEY_NAME "$key_name"
		_kv APP_CREDENTIALS_FILE "$creds"
	} >"$tmp"
	mv "$tmp" "$CONFIG_FILE"
	umask "$old_umask"

	log_info "Wrote config to $CONFIG_FILE"
	log_info "Setup complete. Next: 'digital-ocean start' provisions the demo (billable)."
	# stdout carries the config path only (data), per the logging convention.
	echo "$CONFIG_FILE"
}

# --- `digital-ocean provision` / `deprovision` (F6) -------------------------
# HIDDEN low-level commands (not in usage): F7 `start` and F8 `stop`/`destroy`
# are the public surface and call these same helpers. `provision` ensures (find-
# by-name → adopt, else create) a private VPC, the two volumes and the CPU + GPU
# droplets, attaches the volumes, and records `.do/state`. Idempotent — a re-run
# adopts everything and creates nothing (no double-spend). Reads `.do/config`.

# Resolve a DO SSH key NAME to its ID (last field of the matching list row).
# Echoes the ID, or nothing when the name is not registered on the account.
_resolve_ssh_key() { # name
	# doctl right-pads the Name column with spaces to align it, so split on the
	# LAST field for the ID and strip the trailing pad off the name before
	# comparing (a bare `${line% *}` leaves the pad and never matches).
	doctl compute ssh-key list --format Name,ID --no-header 2>/dev/null |
		while IFS= read -r line; do
			id="${line##* }"                        # last whitespace-delimited field (ID)
			kn="${line% *}"                         # everything before it (name may contain spaces)
			kn="${kn%"${kn##*[![:space:]]}"}"       # strip trailing whitespace (the column pad)
			if [ "$kn" = "$1" ]; then
				printf '%s' "$id"
				break
			fi
		done
}

# Ensure a VPC named $1 in $DO_REGION exists. Echoes its ID (adopt or create).
ensure_vpc() { # name
	id="$(doctl vpcs list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	if [ -n "$id" ]; then
		log_info "vpc $1: adopting existing ($id)"
	else
		log_info "vpc $1: creating in $DO_REGION"
		# `doctl vpcs create` does NOT accept --format (unlike volume/droplet
		# create), so create without it, then re-list by name to get the ID.
		doctl vpcs create --name "$1" --region "$DO_REGION" >/dev/null || return 1
		id="$(doctl vpcs list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	fi
	printf '%s' "$id"
}

# Ensure a ${2}GiB volume named $1 in $DO_REGION exists. Echoes its ID. Created
# with an ext4 filesystem so the F5 provision scripts' format-if-empty is a
# guaranteed no-op — they never reformat, so data persists across stop (ADR-0003).
ensure_volume() { # name size-gib
	id="$(doctl compute volume list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	if [ -n "$id" ]; then
		log_info "volume $1: adopting existing ($id)"
	else
		log_info "volume $1: creating (${2}GiB, ext4)"
		id="$(doctl compute volume create "$1" --region "$DO_REGION" --size "${2}GiB" --fs-type ext4 --format ID --no-header)"
	fi
	printf '%s' "$id"
}

# Ensure droplet $1 (size $2, image $3) on $DO_VPC_ID with $SSH_KEY_ID exists.
# Echoes "ID PUBLIC_IP PRIVATE_IP" (adopt or create; create --wait for the IPs).
ensure_droplet() { # name size image
	line="$(doctl compute droplet list --format Name,ID,PublicIPv4,PrivateIPv4 --no-header 2>/dev/null |
		awk -v n="$1" '$1==n{print $2, $3, $4; exit}')"
	if [ -n "$line" ]; then
		log_info "droplet $1: adopting existing"
	else
		log_info "droplet $1: creating ($2, image $3)"
		line="$(doctl compute droplet create "$1" --region "$DO_REGION" --size "$2" --image "$3" \
			--ssh-keys "$SSH_KEY_ID" --vpc-uuid "$DO_VPC_ID" --wait \
			--format ID,PublicIPv4,PrivateIPv4 --no-header)"
	fi
	printf '%s' "$line"
}

# Attach volume $1 to droplet $2. Skips if already on the target; hard-errors if
# attached to a DIFFERENT droplet (shouldn't happen — stop destroys droplets, so
# volumes come back detached; a mismatch means something is off, so fail loudly).
attach_volume() { # vol-id droplet-id
	attached="$(doctl compute volume get "$1" --format DropletIDs --no-header 2>/dev/null | tr -d '[]", ')"
	if [ -z "$attached" ]; then
		log_info "attaching volume $1 → droplet $2"
		doctl compute volume-action attach "$1" "$2" --wait >/dev/null
	elif [ "$attached" = "$2" ]; then
		log_info "volume $1 already attached to $2"
	else
		log_error "volume $1 is attached to a different droplet ($attached) — refusing to reattach."
		return 1
	fi
}

# Rewrite .do/state from the current DO_* vars (atomic, private perms). Called
# after each ensure step so state never claims a resource that wasn't made.
write_state() {
	mkdir -p "$CONFIG_DIR"
	old_umask="$(umask)"
	umask 077
	tmp="$DO_STATE_FILE.tmp.$$"
	{
		printf '# digital-ocean state — written by "digital-ocean provision" (F6). Gitignored; do not commit.\n'
		_kv DO_VPC_ID "${DO_VPC_ID:-}"
		_kv DO_VPC_NAME "${DO_VPC_NAME:-}"
		_kv DO_DATA_VOLUME_ID "${DO_DATA_VOLUME_ID:-}"
		_kv DO_DATA_VOLUME_NAME "${DO_DATA_VOLUME_NAME:-}"
		_kv DO_MODELS_VOLUME_ID "${DO_MODELS_VOLUME_ID:-}"
		_kv DO_MODELS_VOLUME_NAME "${DO_MODELS_VOLUME_NAME:-}"
		_kv DO_CPU_DROPLET_ID "${DO_CPU_DROPLET_ID:-}"
		_kv DO_CPU_PUBLIC_IP "${DO_CPU_PUBLIC_IP:-}"
		_kv DO_CPU_PRIVATE_IP "${DO_CPU_PRIVATE_IP:-}"
		_kv DO_GPU_DROPLET_ID "${DO_GPU_DROPLET_ID:-}"
		_kv DO_GPU_PUBLIC_IP "${DO_GPU_PUBLIC_IP:-}"
		_kv DO_GPU_PRIVATE_IP "${DO_GPU_PRIVATE_IP:-}"
		# Firewall IDs are set by F7 `start` (empty on a bare F6 provision).
		_kv DO_CPU_FW_ID "${DO_CPU_FW_ID:-}"
		_kv DO_GPU_FW_ID "${DO_GPU_FW_ID:-}"
	} >"$tmp"
	mv "$tmp" "$DO_STATE_FILE"
	umask "$old_umask"
}

# Load .do/config and apply F6 defaults (env override > config > default). Fails
# if no config exists. Sets DO_REGION, sizes, resource names, and image slugs.
_provision_load_config() {
	if [ ! -f "$CONFIG_FILE" ]; then
		log_error "no config at $CONFIG_FILE — run 'digital-ocean setup' first."
		return 1
	fi
	log_debug "loading config $CONFIG_FILE"
	# shellcheck disable=SC1090
	. "$CONFIG_FILE"

	DO_REGION="${DO_REGION:-ams3}"
	DO_CPU_SIZE="${DO_CPU_SIZE:-s-2vcpu-4gb}"
	DO_GPU_SIZE="${DO_GPU_SIZE:-gpu-4000adax1-20gb}"
	# Ollama backend (#18) + optional firewall (#19).
	OLLAMA_BACKEND="${OLLAMA_BACKEND:-cpu}"
	DO_OLLAMA_CPU_SIZE="${DO_OLLAMA_CPU_SIZE:-s-8vcpu-16gb-amd}"
	DO_ENABLE_FIREWALL="${DO_ENABLE_FIREWALL:-0}"
	if [ "$OLLAMA_BACKEND" != cpu ] && [ "$OLLAMA_BACKEND" != gpu ]; then
		log_error "OLLAMA_BACKEND must be 'cpu' or 'gpu' (got '$OLLAMA_BACKEND')."
		return 1
	fi
	# Default so a config missing this key gives the clean "key not found" error
	# below rather than a set -u "unbound variable" crash.
	DO_SSH_KEY_NAME="${DO_SSH_KEY_NAME:-}"
	# Resource names — fixed hello-do- prefix, overridable via env/config.
	DO_VPC_NAME="${DO_VPC_NAME:-hello-do-vpc}"
	DO_DATA_VOLUME_NAME="${DO_DATA_VOLUME_NAME:-hello-do-data}"
	DO_MODELS_VOLUME_NAME="${DO_MODELS_VOLUME_NAME:-hello-do-models}"
	DO_CPU_NAME="${DO_CPU_NAME:-hello-do-cpu}"
	DO_GPU_NAME="${DO_GPU_NAME:-hello-do-gpu}"
	# Volume sizes in GiB (ADR-0003 defaults).
	DO_DATA_SIZE="${DO_DATA_SIZE:-10}"
	DO_MODELS_SIZE="${DO_MODELS_SIZE:-50}"
	# Droplet images. CPU: stock Ubuntu (matches provision-cpu.sh). GPU: DO's
	# AI/ML-ready image that ships the NVIDIA driver provision-gpu.sh asserts —
	# the default here is a PLACEHOLDER to be confirmed at VERIFY via
	# `doctl compute image list --public`; override with DO_GPU_IMAGE.
	DO_CPU_IMAGE="${DO_CPU_IMAGE:-ubuntu-22-04-x64}"
	DO_GPU_IMAGE="${DO_GPU_IMAGE:-gpu-ubuntu-22-04}"

	# The "Ollama node" is the DO_GPU_* droplet regardless of backend (the state
	# keys stay DO_GPU_* — see design/overview.md). In cpu mode it's a plain CPU
	# droplet (DO_OLLAMA_CPU_SIZE, stock Ubuntu image); in gpu mode a GPU droplet.
	if [ "$OLLAMA_BACKEND" = gpu ]; then
		DO_OLLAMA_NODE_SIZE="$DO_GPU_SIZE"
		DO_OLLAMA_NODE_IMAGE="$DO_GPU_IMAGE"
	else
		DO_OLLAMA_NODE_SIZE="$DO_OLLAMA_CPU_SIZE"
		DO_OLLAMA_NODE_IMAGE="$DO_CPU_IMAGE"
	fi
}

cmd_provision() {
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'provision': $1"
		usage >&2
		return 2
	fi

	_provision_load_config || return 1

	log_info "Provisioning DO resources in $DO_REGION — this CREATES BILLABLE resources."

	# Resolve the SSH key up front so a bad key name fails BEFORE anything bills.
	SSH_KEY_ID="$(_resolve_ssh_key "$DO_SSH_KEY_NAME")"
	if [ -z "$SSH_KEY_ID" ]; then
		log_error "DO SSH key '$DO_SSH_KEY_NAME' not found (doctl compute ssh-key list)."
		log_error "Fix DO_SSH_KEY_NAME in $CONFIG_FILE, or import it: doctl compute ssh-key import <name> --public-key-file ~/.ssh/id_ed25519.pub"
		return 1
	fi

	DO_VPC_ID="$(ensure_vpc "$DO_VPC_NAME")"
	write_state

	DO_DATA_VOLUME_ID="$(ensure_volume "$DO_DATA_VOLUME_NAME" "$DO_DATA_SIZE")"
	DO_MODELS_VOLUME_ID="$(ensure_volume "$DO_MODELS_VOLUME_NAME" "$DO_MODELS_SIZE")"
	write_state

	cpu_line="$(ensure_droplet "$DO_CPU_NAME" "$DO_CPU_SIZE" "$DO_CPU_IMAGE")"
	DO_CPU_DROPLET_ID="$(printf '%s' "$cpu_line" | awk '{print $1}')"
	DO_CPU_PUBLIC_IP="$(printf '%s' "$cpu_line" | awk '{print $2}')"
	DO_CPU_PRIVATE_IP="$(printf '%s' "$cpu_line" | awk '{print $3}')"
	gpu_line="$(ensure_droplet "$DO_GPU_NAME" "$DO_OLLAMA_NODE_SIZE" "$DO_OLLAMA_NODE_IMAGE")"
	DO_GPU_DROPLET_ID="$(printf '%s' "$gpu_line" | awk '{print $1}')"
	DO_GPU_PUBLIC_IP="$(printf '%s' "$gpu_line" | awk '{print $2}')"
	DO_GPU_PRIVATE_IP="$(printf '%s' "$gpu_line" | awk '{print $3}')"
	write_state

	# data → CPU, models → GPU (ADR-0003).
	attach_volume "$DO_DATA_VOLUME_ID" "$DO_CPU_DROPLET_ID"
	attach_volume "$DO_MODELS_VOLUME_ID" "$DO_GPU_DROPLET_ID"
	write_state

	log_info "Provisioned. CPU $DO_CPU_PUBLIC_IP (private $DO_CPU_PRIVATE_IP), GPU $DO_GPU_PUBLIC_IP (private $DO_GPU_PRIVATE_IP)."
	log_info "State recorded at $DO_STATE_FILE"
	# stdout carries the state path only (data), per the logging convention.
	echo "$DO_STATE_FILE"
}

cmd_deprovision() {
	WITH_VOLUMES=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--volumes)
			WITH_VOLUMES=1
			shift
			;;
		*)
			log_error "unknown argument to 'deprovision': $1"
			usage >&2
			return 2
			;;
		esac
	done

	if [ ! -f "$DO_STATE_FILE" ]; then
		log_info "no state at $DO_STATE_FILE — nothing to deprovision."
		return 0
	fi
	# shellcheck disable=SC1090
	. "$DO_STATE_FILE"

	# Destroy both droplets (stop semantics — ADR-0001). Best-effort per resource.
	for d in "${DO_CPU_DROPLET_ID:-}" "${DO_GPU_DROPLET_ID:-}"; do
		if [ -n "$d" ]; then
			log_info "destroying droplet $d"
			doctl compute droplet delete "$d" --force >/dev/null 2>&1 || log_error "failed to delete droplet $d"
		fi
	done
	DO_CPU_DROPLET_ID=""
	DO_CPU_PUBLIC_IP=""
	DO_CPU_PRIVATE_IP=""
	DO_GPU_DROPLET_ID=""
	DO_GPU_PUBLIC_IP=""
	DO_GPU_PRIVATE_IP=""

	if [ "$WITH_VOLUMES" -eq 1 ]; then
		for v in "${DO_DATA_VOLUME_ID:-}" "${DO_MODELS_VOLUME_ID:-}"; do
			if [ -n "$v" ]; then
				log_info "destroying volume $v"
				doctl compute volume delete "$v" --force >/dev/null 2>&1 || log_error "failed to delete volume $v"
			fi
		done
		if [ -n "${DO_VPC_ID:-}" ]; then
			log_info "destroying vpc $DO_VPC_ID"
			doctl vpcs delete "$DO_VPC_ID" >/dev/null 2>&1 || log_error "failed to delete vpc $DO_VPC_ID"
		fi
		rm -f "$DO_STATE_FILE"
		log_info "deprovisioned droplets + volumes + VPC. Removed $DO_STATE_FILE"
		return 0
	fi

	write_state
	log_info "deprovisioned droplets (volumes + VPC kept). State at $DO_STATE_FILE"
}

# --- `digital-ocean start` (F7) ---------------------------------------------
# The public end-to-end orchestration: provision (reuse F6) → firewalls → wait for
# SSH → sync code → run F5 provision scripts over SSH → ollama pull → scp creds →
# deploy the F2 demo app as a systemd unit (APP_ENV=DO_DEMO, private Ollama URL) →
# health checks → print the public URL + ready-to-paste ssh commands. Idempotent:
# a re-run adopts every resource, re-syncs, and restarts the service.

# Where `start` pins droplet host keys (accept-new on first connect, then verify).
KNOWN_HOSTS="$CONFIG_DIR/known_hosts"
# Waits (overridable so tests run fast). SSH: fresh droplets take a bit to boot.
DO_SSH_WAIT_SECS="${DO_SSH_WAIT_SECS:-180}"
DO_HEALTH_WAIT_SECS="${DO_HEALTH_WAIT_SECS:-120}"

# Standard SSH options: batch (never prompt), accept-new host keys into our pinned
# known_hosts, a bounded connect timeout, and keepalives so a STALLED connection
# is torn down (ServerAliveInterval*CountMax ≈ 60s) instead of hanging forever — a
# fresh droplet's sshd can stall mid-transfer during cloud-init. A resolved local
# key is added if we find one; otherwise we fall back to the agent/default identities.
_ssh_opts() {
	printf '%s' "-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$KNOWN_HOSTS -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
	keyfile="$(_local_ssh_key || true)"
	[ -n "$keyfile" ] && printf ' %s' "-i $keyfile"
}

# _retry N CMD... — run CMD up to N times with a short backoff, returning success
# on the first pass. Used to ride out fresh-droplet transients (sshd restarting
# under cloud-init) that make an early rsync reset or stall; every retried step is
# idempotent, so a re-attempt is always safe.
_retry() { # count cmd...
	tries="$1"; shift
	i=1
	while true; do
		if "$@"; then return 0; fi
		if [ "$i" -ge "$tries" ]; then
			log_error "still failing after $tries attempts: $*"
			return 1
		fi
		log_info "attempt $i/$tries failed; retrying in ${DO_RETRY_SLEEP:-5}s: $1"
		sleep "${DO_RETRY_SLEEP:-5}"
		i=$((i + 1))
	done
}

# _ssh HOST REMOTE-COMMAND — run one (single-line) command as root on HOST.
# The unquoted $(_ssh_opts) is deliberate: it must word-split into separate ssh
# flags, and this file avoids arrays (runs under bash and zsh). $2 expands on the
# client (SC2029) by design — the remote command is built only from our own vars.
_ssh() { # host command
	# shellcheck disable=SC2046,SC2086,SC2029
	ssh $(_ssh_opts) "root@$1" "$2"
}

# _scp LOCAL HOST:REMOTE — copy a local file to a droplet.
_scp() { # local remote
	# shellcheck disable=SC2046,SC2086
	scp $(_ssh_opts) "$1" "$2"
}

# _rsync LOCAL... HOST:DIR — sync local trees to a droplet over ssh. Excludes the
# Mac-local runtime cruft (venv, pycache, LOCAL run data) so only source ships.
_rsync() { # local... remote
	# NO --delete-excluded: a Homebrew rsync (3.2.7) sending it to Ubuntu's rsync
	# (3.2.3) overflows the receiver's rule buffer (exclude.c recv_rules) and kills
	# the remote — a cross-version filter-rule incompatibility. It isn't needed here
	# (droplets are ephemeral so /opt/app starts empty, and the --exclude list
	# already keeps cruft out of the transfer). --timeout=120 aborts a stalled
	# transfer instead of hanging; callers wrap this in _retry to ride out a
	# fresh-boot reset.
	# shellcheck disable=SC2086
	rsync -az --timeout=120 \
		--exclude='.venv' --exclude='__pycache__' --exclude='*.pyc' \
		--exclude='.localdata' --exclude='.pytest_cache' \
		-e "ssh $(_ssh_opts)" "$@"
}

# Poll until SSH answers on HOST, up to DO_SSH_WAIT_SECS. Fresh droplets need a
# moment before sshd is up; a bad key or blocked port fails the whole start here.
_wait_ssh() { # host
	waited=0
	mkdir -p "$CONFIG_DIR"
	while true; do
		if _ssh "$1" "true" >/dev/null 2>&1; then
			log_info "ssh up on $1"
			return 0
		fi
		if [ "$waited" -ge "$DO_SSH_WAIT_SECS" ]; then
			log_error "ssh never became reachable on $1 after ${DO_SSH_WAIT_SECS}s"
			return 1
		fi
		log_debug "waiting for ssh on $1 (${waited}s)"
		sleep 1
		waited=$((waited + 1))
	done
}

# Ensure a DO cloud firewall named $1 with the given inbound rules exists (adopt by
# name, else create). Outbound is allow-all — a firewall with NO outbound rules
# blocks ALL egress, which would break apt/pip/ollama installs. Echoes the ID.
FW_OUTBOUND_ALL="protocol:tcp,ports:all,address:0.0.0.0/0,address:::/0 protocol:udp,ports:all,address:0.0.0.0/0,address:::/0 protocol:icmp,address:0.0.0.0/0,address:::/0"
ensure_firewall() { # name inbound-rules
	id="$(doctl compute firewall list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	if [ -n "$id" ]; then
		log_info "firewall $1: adopting existing ($id)"
	else
		log_info "firewall $1: creating"
		id="$(doctl compute firewall create --name "$1" \
			--inbound-rules "$2" --outbound-rules "$FW_OUTBOUND_ALL" \
			--format ID --no-header 2>/dev/null)"
		if [ -z "$id" ]; then
			log_error "firewall $1: create failed — the doctl token likely lacks firewall scope (#16)."
			log_error "Set DO_ENABLE_FIREWALL=0 to run without it: Ollama is already off the public net via its private-IP bind (#19)."
			return 1
		fi
	fi
	printf '%s' "$id"
}

# Assign droplet $2 to firewall $1 (idempotent — DO ignores a droplet already on it).
# Hard-fails on error: a firewall that never took effect is a security gap (Ollama
# left open / app unreachable), not something to log-and-continue past.
assign_firewall() { # fw-id droplet-id
	if ! doctl compute firewall add-droplets "$1" --droplet-ids "$2" >/dev/null 2>&1; then
		log_error "could not assign droplet $2 to firewall $1"
		return 1
	fi
}

cmd_start() {
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'start': $1"
		usage >&2
		return 2
	fi

	# 1. Provision (reuse F6). This sets DO_* resource vars in our scope and writes
	#    .do/state; its stdout (the state path) is data we don't want in start's.
	if ! cmd_provision >/dev/null; then
		return 1
	fi
	# Re-read state so IPs/IDs are explicit (and to decouple from provision internals).
	# shellcheck disable=SC1090
	. "$DO_STATE_FILE"

	# 2. Firewalls (OPTIONAL — #19). Ollama is kept off the public net by its
	# private-IP bind (step 5), so a DO firewall is defense-in-depth, default off.
	# Enabling it needs a firewall-scoped token (#16); skipping it lets `start` run
	# on the current token.
	if [ "$DO_ENABLE_FIREWALL" = 1 ]; then
		log_info "Securing with DO cloud firewalls (DO_ENABLE_FIREWALL=1)."
		# CPU: app + ssh public. GPU/Ollama node: :11434 only from inside the VPC.
		# The Ollama rule MUST be scoped to the VPC range — if we can't resolve it,
		# fail rather than fall back to a rule that would expose Ollama.
		vpc_range="$(doctl vpcs get "$DO_VPC_ID" --format IPRange --no-header 2>/dev/null)"
		if [ -z "$vpc_range" ]; then
			log_error "could not resolve the VPC IP range for $DO_VPC_ID — refusing to open Ollama without it."
			return 1
		fi
		DO_CPU_FW_ID="$(ensure_firewall "${DO_CPU_NAME}-fw" \
			"protocol:tcp,ports:5000,address:0.0.0.0/0,address:::/0 protocol:tcp,ports:22,address:0.0.0.0/0,address:::/0")" || return 1
		DO_GPU_FW_ID="$(ensure_firewall "${DO_GPU_NAME}-fw" \
			"protocol:tcp,ports:11434,address:$vpc_range protocol:tcp,ports:22,address:0.0.0.0/0,address:::/0")" || return 1
		assign_firewall "$DO_CPU_FW_ID" "$DO_CPU_DROPLET_ID" || return 1
		assign_firewall "$DO_GPU_FW_ID" "$DO_GPU_DROPLET_ID" || return 1
	else
		log_info "Skipping DO firewalls (DO_ENABLE_FIREWALL=0); Ollama stays private via its VPC-IP bind (#19)."
	fi
	write_state

	# 3. Wait for SSH on both droplets before touching them.
	log_info "Waiting for SSH on both droplets."
	_wait_ssh "$DO_CPU_PUBLIC_IP" || return 1
	_wait_ssh "$DO_GPU_PUBLIC_IP" || return 1

	# 4. Sync the app + provisioning scripts to /opt/app on both hosts. A fresh
	# droplet's sshd can reset or stall the first transfers while cloud-init runs,
	# so retry each step (all idempotent) rather than fail the whole start.
	log_info "Syncing demo/ + infra/ to /opt/app on both droplets."
	_retry 5 _ssh "$DO_CPU_PUBLIC_IP" "mkdir -p /opt/app" || return 1
	_retry 5 _ssh "$DO_GPU_PUBLIC_IP" "mkdir -p /opt/app" || return 1
	_retry 5 _rsync "$REPO_ROOT/demo" "$REPO_ROOT/infra" "root@$DO_CPU_PUBLIC_IP:/opt/app/" || return 1
	_retry 5 _rsync "$REPO_ROOT/demo" "$REPO_ROOT/infra" "root@$DO_GPU_PUBLIC_IP:/opt/app/" || return 1

	# 5. Ollama node: provision (F5), then pull the model (C8 — persists on
	# /mnt/models). Bind Ollama to the node's PRIVATE VPC IP (#19) so :11434 is off
	# the public net with no firewall. The provisioning script depends on the
	# backend (#18): CPU (plain Ubuntu, no NVIDIA) vs GPU. `ollama pull` must use
	# the same private host — the CLI otherwise defaults to loopback.
	ollama_bind="$DO_GPU_PRIVATE_IP:11434"
	if [ "$OLLAMA_BACKEND" = gpu ]; then
		log_info "Provisioning GPU Ollama node + pulling model '$OLLAMA_MODEL'."
		_ssh "$DO_GPU_PUBLIC_IP" \
			"MODELS_VOLUME_NAME=$DO_MODELS_VOLUME_NAME OLLAMA_HOST=$ollama_bind bash /opt/app/infra/provision-gpu.sh" || return 1
	else
		log_info "Provisioning CPU Ollama node + pulling model '$OLLAMA_MODEL'."
		_ssh "$DO_GPU_PUBLIC_IP" \
			"MODELS_VOLUME_NAME=$DO_MODELS_VOLUME_NAME OLLAMA_HOST=$ollama_bind bash /opt/app/infra/provision-ollama-cpu.sh" || return 1
	fi
	_ssh "$DO_GPU_PUBLIC_IP" "OLLAMA_HOST=$ollama_bind ollama pull $OLLAMA_MODEL" || return 1

	# 6. CPU: provision (F5), copy creds (C9/ADR-0005), deploy the app (C10) as a
	#    systemd unit wired to the GPU's PRIVATE Ollama URL (ADR-0007).
	log_info "Provisioning CPU droplet + deploying the demo app."
	_ssh "$DO_CPU_PUBLIC_IP" \
		"DATA_VOLUME_NAME=$DO_DATA_VOLUME_NAME bash /opt/app/infra/provision-cpu.sh" || return 1
	_ssh "$DO_CPU_PUBLIC_IP" "mkdir -p /etc/app" || return 1
	_scp "$APP_CREDENTIALS_FILE" "root@$DO_CPU_PUBLIC_IP:/etc/app/credentials" || return 1
	_deploy_app "$DO_CPU_PUBLIC_IP" "$DO_GPU_PRIVATE_IP" || return 1

	# 7. Health checks (C11): Ollama reachable over the PRIVATE IP from the CPU,
	#    then the app answers /health. Not healthy = not Done.
	log_info "Running health checks."
	if ! _ssh "$DO_CPU_PUBLIC_IP" "curl -fsS --max-time 5 http://$DO_GPU_PRIVATE_IP:11434/api/tags >/dev/null"; then
		log_error "Ollama not reachable at $DO_GPU_PRIVATE_IP:11434 from the CPU droplet (VPC/firewall?)."
		return 1
	fi
	if ! _wait_app_health "$DO_CPU_PUBLIC_IP"; then
		log_error "demo app health check never passed on $DO_CPU_PUBLIC_IP:5000"
		return 1
	fi

	log_info "Demo is up."
	# stdout carries the public URL + ready-to-paste ssh commands (data; ADR-0006).
	echo "http://$DO_CPU_PUBLIC_IP:5000"
	echo "ssh root@$DO_CPU_PUBLIC_IP   # CPU droplet (app)"
	echo "ssh root@$DO_GPU_PUBLIC_IP   # GPU droplet (Ollama)"
}

# Write + enable the demo app's systemd unit on the CPU, wired to the GPU's private
# Ollama URL. Kept a single ssh command (printf '%b' expands the \n escapes) so the
# whole unit ships in one round-trip and logs on one line.
_deploy_app() { # cpu-ip gpu-private-ip
	unit='[Unit]\n'
	unit="${unit}Description=hello-digital-ocean demo app\n"
	unit="${unit}After=network-online.target\n\n"
	unit="${unit}[Service]\n"
	unit="${unit}Environment=APP_ENV=DO_DEMO\n"
	unit="${unit}Environment=OLLAMA_URL=http://$2:11434\n"
	unit="${unit}Environment=OLLAMA_MODEL=$OLLAMA_MODEL\n"
	unit="${unit}Environment=APP_DATA_DIR=/mnt/data\n"
	unit="${unit}Environment=APP_CREDENTIALS_FILE=/etc/app/credentials\n"
	unit="${unit}ExecStart=/opt/app/.venv/bin/python /opt/app/demo/app.py\n"
	unit="${unit}Restart=on-failure\n\n"
	unit="${unit}[Install]\n"
	unit="${unit}WantedBy=multi-user.target\n"
	_ssh "$1" "printf '%b' '$unit' >/etc/systemd/system/app.service; systemctl daemon-reload; systemctl enable app.service; systemctl restart app.service"
}

# Poll the app's /health from inside the CPU droplet up to DO_HEALTH_WAIT_SECS.
_wait_app_health() { # cpu-ip
	waited=0
	while true; do
		if _ssh "$1" "curl -fsS --max-time 5 http://127.0.0.1:5000/health >/dev/null" 2>/dev/null; then
			return 0
		fi
		if [ "$waited" -ge "$DO_HEALTH_WAIT_SECS" ]; then
			return 1
		fi
		sleep 1
		waited=$((waited + 1))
	done
}

# --- Dispatch ----------------------------------------------------------------

main() {
	# Leading global flags, then dispatch on the first non-flag as a command.
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			return 0
			;;
		-v | --verbose)
			LOG_LEVEL=DEBUG
			shift
			;;
		--)
			shift
			break
			;;
		-*)
			log_error "unknown argument: $1"
			usage >&2
			return 2
			;;
		*)
			break
			;;
		esac
	done

	if [ $# -eq 0 ]; then
		# No command — keep the skeleton banner (used by F1's smoke tests).
		log_info "Starting digital-ocean."
		log_debug "Log level: $LOG_LEVEL"
		echo "digital-ocean control CLI. Run with --help for usage."
		log_info "Done."
		return 0
	fi

	subcommand="$1"
	shift
	case "$subcommand" in
	setup)
		cmd_setup "$@"
		;;
	local)
		cmd_local "$@"
		;;
	start)
		cmd_start "$@"
		;;
	provision)
		cmd_provision "$@"
		;;
	deprovision)
		cmd_deprovision "$@"
		;;
	*)
		log_error "unknown command: $subcommand"
		usage >&2
		return 2
		;;
	esac
}

# Allow sourcing the helper functions WITHOUT executing (DO_SOURCE_ONLY=1) — used
# by the real-boundary test (tests/integration/do-provision.bats) to drive the
# ensure_* functions against live DO, and available for F7's start to reuse.
if [ -z "${DO_SOURCE_ONLY:-}" ]; then
	main "$@"
fi
