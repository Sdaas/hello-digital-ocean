#!/usr/bin/env bash
#
# digital-ocean — control CLI for DigitalOcean app hosts.
#
# This is the MAIN ARTIFACT of the hello-digital-ocean repo: a Mac-side control
# CLI that provisions and tears down the DigitalOcean infrastructure (droplets +
# volumes) and runs a conforming app on it — chosen with `--app-dir <dir>` and its
# digital-ocean.yml manifest (F11/#27; the bundled `demo/` is the reference app).
# E.g. `digital-ocean --app-dir demo start`, `digital-ocean stop`,
# `digital-ocean setup`, `digital-ocean destroy`, `digital-ocean --app-dir demo local`.
# The cloud subcommands are added by later features (F4–F9); F3 ships the first
# real subcommand, `local`, plus the subcommand dispatcher those siblings build on.
#
# Written to run under both bash and zsh: avoids bash-only features
# (no arrays, no ${BASH_SOURCE}). Keep it that way.

set -eu

# --- Paths (portable: derive from $0, no ${BASH_SOURCE}) --------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# The app to run/deploy is selected with the global `--app-dir <dir>` flag (F11,
# #27); its digital-ocean.yml manifest supplies every app-specific fact. Nothing
# below hardcodes the demo — _load_manifest resolves it all. DO_APP_DIR is an env
# fallback (handy for a vendored copy that always targets one app).
APP_DIR_OPT="${DO_APP_DIR:-}"

# Deployment environment (F12, #29): `prod` (default) or `staging`, chosen with the
# global `--env` flag. It selects the manifest's `deployments.<env>` infra block AND
# the per-env run-state file (.do/state.<env>), and is the `<env>` token in every DO
# resource name (`<name>-<env>-…`). DO_ENV is an env fallback (handy for a vendored
# copy pinned to one env); --env overrides it. Validated in main().
DEPLOY_ENV="${DO_ENV:-prod}"

# `local` runtime state (pid + captured app log). DO_LOCAL_STATE_DIR overrides the
# location (tests point it at a throwaway dir); otherwise it derives from the app
# dir. STATE_DIR/PID_FILE/LOG_FILE/LOCAL_URL are set by _resolve_local_state /
# cmd_local, not here — they depend on the chosen app.

# The venv `local` builds from the app's requirements (the SAME set that ships to
# DO — proving one dependency set runs in both places, UC7).
VENV="$REPO_ROOT/.venv"

# Local Ollama endpoint (the app's OLLAMA_URL in `local`).
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"

# Where `setup` (F4) writes the local config. Repo-local and gitignored;
# overridable so tests point it at a throwaway dir. The cloud commands (F6/F7)
# read this file. Env-style KEY=value (sourceable — no jq dependency).
CONFIG_DIR="${DO_CONFIG_DIR:-$REPO_ROOT/.do}"
CONFIG_FILE="$CONFIG_DIR/config"
# Where `provision` (F6) records the DO resource state (VPC, volume,
# droplet IDs + IPs). Same dir/discipline as the config: repo-local, gitignored,
# written 0600, sourceable env-style KEY=value. F7/F8/F9 read this file. PER-ENV
# (F12, #29): `.do/state.<env>` so prod and staging never clobber each other's IDs.
# Re-derived in main() after --env is parsed (DEPLOY_ENV may change there).
_resolve_state_file() { DO_STATE_FILE="$CONFIG_DIR/state.$DEPLOY_ENV"; }
_resolve_state_file

# --- Logging (see design/overview.md) ---------------------------------------
# Leveled logging to STDERR so stdout carries only real output/data. Two levels
# the user selects: INFO (default) and DEBUG (via --verbose); ERROR is always
# emitted. Each line is "<ISO-8601 UTC> <LEVEL> digital-ocean: <message>".
LOG_LEVEL=INFO

log() { # log LEVEL message...
	level="$1"
	shift
	# DEBUG lines only appear when the user asked for --verbose.
	if [ "$level" = DEBUG ] && [ "$LOG_LEVEL" != DEBUG ]; then
		return 0
	fi
	printf '%s %s digital-ocean: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$level" "$*" >&2
}
log_debug() { log DEBUG "$@"; }
log_info() { log INFO "$@"; }
log_error() { log ERROR "$@"; }

usage() {
	cat <<EOF
Usage: digital-ocean [--help] [--verbose] [--app-dir <dir>] [--env <env>] [<command>]

Control CLI for DigitalOcean — provisions/tears down the DO infrastructure and
runs a conforming app on it. The app is chosen with --app-dir <dir>, which must
hold a digital-ocean.yml manifest (see demo/digital-ocean.yml for the reference).

Global options:
  --app-dir <dir>  App to run/deploy (dir containing digital-ocean.yml). Required
                   by 'local', 'start' and 'provision'. Also settable via \$DO_APP_DIR.
  --env <env>      Deployment environment: prod (default) or staging. Selects the
                   manifest deployments.<env> infra block, the .do/state.<env> file,
                   and the <env> token in resource names. Also settable via \$DO_ENV.

Commands:
  setup            One-time local preflight + interview → write local config.
  setup --non-interactive   Same, no prompts (accept defaults / env overrides).
  local            Run the app on this Mac (venv + browser). Needs --app-dir.
  local down       Stop the locally running app.
  start            Provision DO infra + deploy the app end-to-end (BILLABLE);
                   prints the public URL and ssh commands when healthy. Needs --app-dir.
  stop             Tear down the droplets + firewalls; KEEP volumes + VPC so a
                   later 'start' reuses the data (stops billing for compute).
  destroy          Full teardown: droplets + firewalls + volumes + VPC (all data
                   lost). Prompts to confirm; -y / --non-interactive skips it.

Debug helpers (need a running host — see 'start'):
  ssh [cpu|gpu] [cmd...]   Open a root shell on the droplet (default cpu), or run
                   'cmd' there one-shot (e.g. 'ssh gpu nvidia-smi').
  logs [cpu|gpu] [-f]      Tail the service journal (cpu=app, gpu=ollama; default
                   cpu). -f/--follow streams instead of the last 100 lines.
  status [cpu|gpu]         Service state + health probe. No target → both nodes.

With no command, prints a short banner.
EOF
}

# --- App manifest (F11, #27) -------------------------------------------------
# `digital-ocean.yml` (in the app dir) carries the per-app facts the CLI used to
# hardcode for the demo. `infra/` stays tool-owned. The app dir is chosen with
# the global `--app-dir <dir>` flag; the manifest lives at <app-dir>/digital-ocean.yml.

# Read one scalar KEY from a flat "key: value" manifest. Comment lines and blanks
# are ignored; an inline " # comment" after a value is stripped; surrounding
# single/double quotes are removed; a colon inside the value (e.g. a model tag
# llama3.2:1b) is preserved because only the FIRST colon is the key separator.
#
# Deliberately a minimal flat-YAML reader — no jq/yq (matches this repo's
# dependency-light ethos). YAGNI: if the manifest ever grows nested maps or lists,
# replace this with a real YAML parser rather than extending the awk below.
_manifest_get() { # file key
	awk -v k="$2" '
		/^[[:space:]]*#/ { next }                     # comment line
		{
			line = $0
			sub(/[[:space:]]+#.*$/, "", line)         # strip inline trailing comment
			if (match(line, "^[[:space:]]*" k "[[:space:]]*:")) {
				val = substr(line, RLENGTH + 1)       # everything after "key:"
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)          # trim
				if (val ~ /^".*"$/ || val ~ /^'\''.*'\''$/)          # strip matching quotes
					val = substr(val, 2, length(val) - 2)
				print val
				exit
			}
		}
	' "$1"
}

# Read one scalar KEY from the `deployments: <env>:` block of the manifest (F12,
# #29). This is the minimal 2-LEVEL companion to _manifest_get above — the F11
# note anticipated exactly this growth. Structure is tracked by state, not fixed
# indentation depth (portable — no awk interval `{n}` regexes): a top-level line
# (re)sets context; a `deployments:` top-level line opens the block; an indented
# header "  <name>:" (a colon with NO value) selects the environment; an indented
# "    key: value" under the selected environment yields the value. Quotes and
# inline comments are handled exactly like the flat reader.
_manifest_get_deployment() { # file env key
	awk -v env="$2" -v k="$3" '
		/^[[:space:]]*#/ { next }                          # comment line
		{
			line = $0
			sub(/[[:space:]]+#.*$/, "", line)              # strip inline trailing comment
			if (line ~ /^[[:space:]]*$/) next              # blank

			if (line ~ /^[^[:space:]]/) {                  # top-level key: (re)set context
				in_deploy = (line ~ /^deployments[[:space:]]*:/)
				in_env = 0
				next
			}
			if (!in_deploy) next

			# An indented header "  <name>:" (colon, no value) selects the env.
			if (line ~ /^[[:space:]]+[^:[:space:]][^:]*:[[:space:]]*$/) {
				envname = line
				sub(/^[[:space:]]+/, "", envname)
				sub(/[[:space:]]*:[[:space:]]*$/, "", envname)
				in_env = (envname == env)
				next
			}
			if (!in_env) next

			# An indented "    key: value" under the selected env.
			if (match(line, "^[[:space:]]+" k "[[:space:]]*:")) {
				val = substr(line, RLENGTH + 1)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
				if (val ~ /^".*"$/ || val ~ /^'\''.*'\''$/)
					val = substr(val, 2, length(val) - 2)
				print val
				exit
			}
		}
	' "$1"
}

# Resolve --app-dir and load+validate the manifest into APP_* vars used by
# `local` and `start`. Sets: APP_CODE_DIR (abs app code root), APP_ENTRYPOINT and
# APP_REQUIREMENTS_REL (relative to APP_CODE_DIR), APP_PORT, APP_HEALTH_PATH,
# APP_OLLAMA_MODEL, APP_CREDS_ENV (0|1). Returns 2 (usage) when --app-dir is
# absent, 1 when the dir/manifest/keys are bad.
_load_manifest() {
	if [ -z "$APP_DIR_OPT" ]; then
		log_error "no app selected — pass --app-dir <dir> (the directory holding digital-ocean.yml)."
		usage >&2
		return 2
	fi
	if [ ! -d "$APP_DIR_OPT" ]; then
		log_error "--app-dir '$APP_DIR_OPT' is not a directory."
		return 1
	fi
	APP_DIR_ABS="$(cd "$APP_DIR_OPT" && pwd)"
	MANIFEST="$APP_DIR_ABS/digital-ocean.yml"
	if [ ! -f "$MANIFEST" ]; then
		log_error "no manifest at $MANIFEST — every app needs a digital-ocean.yml (see demo/digital-ocean.yml)."
		return 1
	fi

	APP_NAME="$(_manifest_get "$MANIFEST" name)"
	m_app_dir="$(_manifest_get "$MANIFEST" app_dir)"
	APP_ENTRYPOINT="$(_manifest_get "$MANIFEST" entrypoint)"
	APP_REQUIREMENTS_REL="$(_manifest_get "$MANIFEST" requirements)"
	APP_PORT="$(_manifest_get "$MANIFEST" port)"
	APP_HEALTH_PATH="$(_manifest_get "$MANIFEST" health_path)"
	APP_OLLAMA_MODEL="$(_manifest_get "$MANIFEST" ollama_model)"
	m_creds="$(_manifest_get "$MANIFEST" credentials_env_file)"

	# Every scalar except credentials_env_file (optional) is required.
	for pair in "name=$APP_NAME" "app_dir=$m_app_dir" "entrypoint=$APP_ENTRYPOINT" \
		"requirements=$APP_REQUIREMENTS_REL" "port=$APP_PORT" \
		"health_path=$APP_HEALTH_PATH" "ollama_model=$APP_OLLAMA_MODEL"; do
		if [ -z "${pair#*=}" ]; then
			log_error "manifest $MANIFEST is missing required key: ${pair%%=*}"
			return 1
		fi
	done

	# name becomes the <name> in every DO resource name (F12, #29), so it must be
	# DNS-label-safe: lowercase letters, digits and hyphens only (no leading/trailing
	# hyphen). Reject anything else up front rather than let doctl fail mid-provision.
	case "$APP_NAME" in
	*[!a-z0-9-]* | -* | *- | "")
		log_error "manifest name '$APP_NAME' is invalid — use lowercase letters, digits and hyphens (e.g. 'demo'), no leading/trailing hyphen."
		return 1
		;;
	esac

	# app_dir is relative to the manifest; entrypoint/requirements are relative to
	# the resolved app code dir.
	if ! APP_CODE_DIR="$(cd "$APP_DIR_ABS/$m_app_dir" 2>/dev/null && pwd)"; then
		log_error "manifest app_dir '$m_app_dir' does not resolve under $APP_DIR_ABS."
		return 1
	fi

	case "$m_creds" in
	1 | true | TRUE | True | yes | on) APP_CREDS_ENV=1 ;;
	*) APP_CREDS_ENV=0 ;;
	esac
}

# --- `digital-ocean local` (F3) ---------------------------------------------

# Reachable if the local Ollama server answers /api/tags. Used as an `if`
# condition, so a non-zero curl doesn't trip `set -e`.
_ollama_reachable() {
	curl -fsS --max-time 2 "$OLLAMA_URL/api/tags" >/dev/null 2>&1
}

# True while pid $1 exists.
_alive() {
	[ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

# Poll the app's health endpoint until it answers 200, up to ~15s.
_wait_health() {
	tries=0
	while [ "$tries" -lt 30 ]; do
		if curl -fsS --max-time 1 "$LOCAL_URL$APP_HEALTH_PATH" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.5
		tries=$((tries + 1))
	done
	return 1
}

# Open the app in a browser, unless suppressed or unavailable.
_open_browser() {
	if [ "${DO_LOCAL_NO_BROWSER:-}" = "1" ]; then
		log_info "browser open skipped (DO_LOCAL_NO_BROWSER=1)"
	elif command -v open >/dev/null 2>&1; then
		open "$LOCAL_URL" || log_error "could not open a browser at $LOCAL_URL"
	else
		log_info "open $LOCAL_URL in your browser"
	fi
}

# Resolve the local run-state dir (pid + captured log). DO_LOCAL_STATE_DIR wins
# (tests); otherwise it lives under the app's own .localdata. Sets STATE_DIR and
# the derived PID_FILE/LOG_FILE.
_resolve_local_state() {
	if [ -n "${DO_LOCAL_STATE_DIR:-}" ]; then
		STATE_DIR="$DO_LOCAL_STATE_DIR"
	elif [ -n "${APP_CODE_DIR:-}" ]; then
		STATE_DIR="$APP_CODE_DIR/.localdata"
	else
		log_error "cannot locate local run-state — pass --app-dir (or set DO_LOCAL_STATE_DIR)."
		return 1
	fi
	PID_FILE="$STATE_DIR/local.pid"
	LOG_FILE="$STATE_DIR/local.log"
}

cmd_local() {
	# `local down` is the teardown; everything else must be empty.
	if [ "${1:-}" = "down" ]; then
		cmd_local_down
		return $?
	fi
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'local': $1"
		usage >&2
		return 2
	fi

	# Learn the app from its manifest (--app-dir), then locate run-state and the
	# local URL (bind 127.0.0.1 on the manifest port).
	_load_manifest || return $?
	_resolve_local_state || return $?
	LOCAL_URL="http://127.0.0.1:$APP_PORT"

	# Already running? Re-open the browser rather than starting a second copy.
	if [ -f "$PID_FILE" ]; then
		running="$(cat "$PID_FILE" 2>/dev/null || true)"
		if _alive "$running"; then
			log_info "digital-ocean local already running (pid $running)."
			_open_browser
			echo "$LOCAL_URL"
			return 0
		fi
		log_debug "removing stale pid file (pid $running no longer alive)"
		rm -f "$PID_FILE"
	fi

	# Fail fast if Ollama is down — before building a venv, so we don't do a
	# pointless pip install when the model backend isn't even up.
	if ! _ollama_reachable; then
		log_error "Ollama is not reachable at $OLLAMA_URL."
		log_error "Start it first, then re-run:  ollama serve"
		return 1
	fi

	# Ensure a venv from the SAME app requirements that ship to DO.
	if [ ! -x "$VENV/bin/python" ]; then
		if ! command -v python3 >/dev/null 2>&1; then
			log_error "python3 not found — install Python 3 to run the app."
			return 1
		fi
		log_info "Creating venv at $VENV"
		if ! python3 -m venv "$VENV"; then
			log_error "failed to create venv at $VENV"
			return 1
		fi
	fi
	log_info "Installing app dependencies ($APP_REQUIREMENTS_REL)"
	if ! PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV/bin/python" -m pip install -q -r "$APP_CODE_DIR/$APP_REQUIREMENTS_REL"; then
		log_error "pip install failed"
		return 1
	fi

	# Launch the app detached with the explicit env contract (F11, #27): bind
	# 127.0.0.1 on the manifest port, point it at local Ollama + the manifest
	# model, and keep its data under the run-state dir. Capture output to the log
	# file and record the pid so `local down` can stop it.
	mkdir -p "$STATE_DIR"
	log_info "Starting app '$APP_ENTRYPOINT' on $LOCAL_URL — logs at $LOG_FILE"
	HOST=127.0.0.1 PORT="$APP_PORT" \
		OLLAMA_URL="$OLLAMA_URL" OLLAMA_MODEL="$APP_OLLAMA_MODEL" \
		APP_DATA_DIR="$STATE_DIR" \
		"$VENV/bin/python" "$APP_CODE_DIR/$APP_ENTRYPOINT" >"$LOG_FILE" 2>&1 &
	app_pid=$!
	echo "$app_pid" >"$PID_FILE"

	# Not healthy = not Done. Wait for the health endpoint, else tear down + report.
	if ! _wait_health; then
		log_error "app did not become healthy — see $LOG_FILE"
		kill "$app_pid" 2>/dev/null || true
		rm -f "$PID_FILE"
		return 1
	fi

	log_info "app healthy at $LOCAL_URL$APP_HEALTH_PATH (pid $app_pid)"
	_open_browser
	# stdout carries the URL only (data), per the logging convention.
	echo "$LOCAL_URL"
}

cmd_local_down() {
	# Locate the run-state dir. DO_LOCAL_STATE_DIR alone is enough (no manifest
	# needed just to stop); otherwise resolve it from --app-dir like `local` did.
	if [ -z "${DO_LOCAL_STATE_DIR:-}" ]; then
		_load_manifest || return $?
	fi
	_resolve_local_state || return $?

	if [ ! -f "$PID_FILE" ]; then
		echo "digital-ocean local: not running."
		return 0
	fi
	pid="$(cat "$PID_FILE" 2>/dev/null || true)"
	if _alive "$pid"; then
		log_info "Stopping app (pid $pid)."
		kill "$pid" 2>/dev/null || true
		# Give it a moment to exit; escalate if it clings on.
		tries=0
		while _alive "$pid" && [ "$tries" -lt 20 ]; do
			sleep 0.2
			tries=$((tries + 1))
		done
		if _alive "$pid"; then
			log_debug "pid $pid still alive; sending SIGKILL"
			kill -9 "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
		echo "digital-ocean local: stopped."
	else
		rm -f "$PID_FILE"
		echo "digital-ocean local: not running (removed stale pid file)."
	fi
	return 0
}

# --- `digital-ocean setup` (F4) ---------------------------------------------
# Local-only: preflight checks, an interview (skippable with --non-interactive),
# and a write of the local config file. Creates ZERO billable resources — the
# only DO calls are read-only (`doctl account get`, `compute ssh-key list`).

# Emit a `KEY='value'` config line with POSIX-safe single-quote escaping, so a
# value containing a quote can't corrupt the file or break the next run's source.
_kv() { # key value
	esc="$(printf '%s' "$2" | sed "s/'/'\\\\''/g")"
	printf "%s='%s'\n" "$1" "$esc"
}

# Region is backend-aware (#17, ADR-0008): the only affordable DO GPU (RTX 6000
# Ada) is tor1-only, while the CPU 16GB Ollama node has no tor1 size — so the GPU
# backend runs in tor1 and the CPU backend in blr1 (India-local). An explicit
# DO_REGION overrides this. Keep the two regions in one place.
_region_for_backend() { # backend(cpu|gpu)
	case "$1" in
	gpu) printf 'tor1' ;;
	*) printf 'blr1' ;;
	esac
}

# Report a required local tool. Missing tools accumulate into _setup_fail.
_check_tool() { # name install-hint
	if command -v "$1" >/dev/null 2>&1; then
		log_info "preflight: $1 found"
	else
		log_error "preflight: $1 not found — $2"
		_setup_fail=1
	fi
}

# Resolve the local SSH private key. DO_SSH_KEY_FILE, when set, is authoritative
# (used exactly, no fallback) so tests are deterministic; otherwise scan the
# usual ~/.ssh candidates. Echoes the path; non-zero if none found.
_local_ssh_key() {
	if [ -n "${DO_SSH_KEY_FILE:-}" ]; then
		printf '%s' "$DO_SSH_KEY_FILE"
		return 0
	fi
	for f in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa"; do
		if [ -f "$f" ]; then
			printf '%s' "$f"
			return 0
		fi
	done
	return 1
}

# Resolve one config field. Precedence: explicit env override > (already-sourced)
# stored config / hardcoded default. Prompts only when interactive and no env
# override was given. Echoes the chosen value.
_field() { # envval default label
	if [ -n "$1" ]; then
		printf '%s' "$1"
		return 0
	fi
	if [ "$NONINTERACTIVE" = 1 ]; then
		printf '%s' "$2"
		return 0
	fi
	printf '%s [%s]: ' "$3" "$2" >&2
	if IFS= read -r reply && [ -n "$reply" ]; then
		printf '%s' "$reply"
	else
		printf '%s' "$2"
	fi
}

cmd_setup() {
	NONINTERACTIVE=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--non-interactive | -y)
			NONINTERACTIVE=1
			shift
			;;
		*)
			log_error "unknown argument to 'setup': $1"
			usage >&2
			return 2
			;;
		esac
	done

	# Capture explicit env overrides BEFORE sourcing the stored config (which
	# would otherwise clobber them).
	# Per-env INFRA (region/sizes/backend/firewall) now lives in the app manifest's
	# deployments.<env> block (F12, #29), so setup is app/env-agnostic and only
	# bootstraps the MACHINE-local facts: the DO SSH key name + local creds path.
	env_keyname="${DO_SSH_KEY_NAME:-}"
	env_creds="${APP_CREDENTIALS_FILE:-}"

	# --- preflight (accumulate ALL failures, then hard-fail) ----------------
	log_info "Running preflight checks (local only — nothing is provisioned)."
	_setup_fail=0
	_check_tool doctl "install doctl: https://docs.digitalocean.com/reference/doctl/how-to/install/"
	_check_tool ssh "install OpenSSH (ssh)"
	_check_tool scp "install OpenSSH (scp)"
	_check_tool curl "install curl"

	# DO auth + a registered key — only worth probing when doctl is present.
	do_key_name=""
	if command -v doctl >/dev/null 2>&1; then
		if doctl account get >/dev/null 2>&1; then
			log_info "preflight: DigitalOcean auth OK (doctl account get)"
		else
			log_error "preflight: doctl is not authenticated — run: doctl auth init"
			_setup_fail=1
		fi
		do_key_name="$(doctl compute ssh-key list --format Name --no-header 2>/dev/null | head -n1)"
		if [ -n "$do_key_name" ]; then
			log_info "preflight: DO-registered SSH key '$do_key_name'"
		else
			log_error "preflight: no DO-registered SSH key — import one: doctl compute ssh-key import <name> --public-key-file ~/.ssh/id_ed25519.pub"
			_setup_fail=1
		fi
	fi

	# Local SSH private key.
	keyfile="$(_local_ssh_key || true)"
	if [ -n "$keyfile" ] && [ -f "$keyfile" ]; then
		log_info "preflight: local SSH key $keyfile"
	else
		log_error "preflight: no local SSH key found — generate one: ssh-keygen -t ed25519"
		_setup_fail=1
	fi

	if [ "$_setup_fail" -ne 0 ]; then
		log_error "preflight failed — fix the items above and re-run 'digital-ocean setup'. No config written."
		return 1
	fi
	log_info "preflight passed."

	# --- interview ----------------------------------------------------------
	# Source any existing config so its values seed the interview defaults.
	if [ -f "$CONFIG_FILE" ]; then
		log_debug "loading existing config $CONFIG_FILE"
		# shellcheck disable=SC1090
		. "$CONFIG_FILE"
	fi

	# NB (#27/#29): OLLAMA_MODEL and all per-env infra (region/sizes/backend/firewall)
	# are per-app/per-env facts and live in the app's digital-ocean.yml manifest —
	# setup no longer asks for or stores them. It bootstraps only machine-local facts.
	key_name="$(_field "$env_keyname" "${DO_SSH_KEY_NAME:-$do_key_name}" "DO SSH key name")"
	creds="$(_field "$env_creds" "${APP_CREDENTIALS_FILE:-$CONFIG_DIR/credentials}" "Local credentials file")"

	# Ensure the credentials file exists (may be empty — ADR-0005).
	credsdir="$(dirname "$creds")"
	mkdir -p "$credsdir"
	[ -f "$creds" ] || : >"$creds"

	# --- write config (atomic, private perms) -------------------------------
	mkdir -p "$CONFIG_DIR"
	old_umask="$(umask)"
	umask 077
	tmp="$CONFIG_FILE.tmp.$$"
	{
		printf '# digital-ocean config — written by "digital-ocean setup" (F4). Gitignored; do not commit.\n'
		printf '# Machine-local facts only (F12, #29): per-env infra lives in the app manifest.\n'
		_kv DO_SSH_KEY_NAME "$key_name"
		_kv APP_CREDENTIALS_FILE "$creds"
	} >"$tmp"
	mv "$tmp" "$CONFIG_FILE"
	umask "$old_umask"

	log_info "Wrote config to $CONFIG_FILE"
	log_info "Setup complete. Next: 'digital-ocean --app-dir <dir> start' deploys your app (billable)."
	# stdout carries the config path only (data), per the logging convention.
	echo "$CONFIG_FILE"
}

# --- `digital-ocean provision` (F6) -----------------------------------------
# HIDDEN low-level command (not in usage): F7 `start` and F8 `stop`/`destroy`
# are the public surface and call these same helpers. `provision` ensures (find-
# by-name → adopt, else create) a private VPC, the two volumes and the CPU + GPU
# droplets, attaches the volumes, and records `.do/state`. Idempotent — a re-run
# adopts everything and creates nothing (no double-spend). Reads `.do/config`.

# Resolve a DO SSH key NAME to its ID (last field of the matching list row).
# Echoes the ID, or nothing when the name is not registered on the account.
_resolve_ssh_key() { # name
	# doctl right-pads the Name column with spaces to align it, so split on the
	# LAST field for the ID and strip the trailing pad off the name before
	# comparing (a bare `${line% *}` leaves the pad and never matches).
	doctl compute ssh-key list --format Name,ID --no-header 2>/dev/null |
		while IFS= read -r line; do
			id="${line##* }"                        # last whitespace-delimited field (ID)
			kn="${line% *}"                         # everything before it (name may contain spaces)
			kn="${kn%"${kn##*[![:space:]]}"}"       # strip trailing whitespace (the column pad)
			if [ "$kn" = "$1" ]; then
				printf '%s' "$id"
				break
			fi
		done
}

# Ensure a VPC named $1 in $DO_REGION exists. Echoes its ID (adopt or create).
ensure_vpc() { # name
	id="$(doctl vpcs list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	if [ -n "$id" ]; then
		log_info "vpc $1: adopting existing ($id)"
	else
		log_info "vpc $1: creating in $DO_REGION"
		# `doctl vpcs create` does NOT accept --format (unlike volume/droplet
		# create), so create without it, then re-list by name to get the ID.
		doctl vpcs create --name "$1" --region "$DO_REGION" >/dev/null || return 1
		id="$(doctl vpcs list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	fi
	printf '%s' "$id"
}

# Ensure a ${2}GiB volume named $1 in $DO_REGION exists. Echoes its ID. Created
# with an ext4 filesystem so the F5 provision scripts' format-if-empty is a
# guaranteed no-op — they never reformat, so data persists across stop (ADR-0003).
ensure_volume() { # name size-gib
	id="$(doctl compute volume list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	if [ -n "$id" ]; then
		log_info "volume $1: adopting existing ($id)"
	else
		log_info "volume $1: creating (${2}GiB, ext4)"
		id="$(doctl compute volume create "$1" --region "$DO_REGION" --size "${2}GiB" --fs-type ext4 --format ID --no-header)"
	fi
	printf '%s' "$id"
}

# Ensure droplet $1 (size $2, image $3) on $DO_VPC_ID with $SSH_KEY_ID exists.
# Echoes "ID PUBLIC_IP PRIVATE_IP" (adopt or create; create --wait for the IPs).
ensure_droplet() { # name size image
	line="$(doctl compute droplet list --format Name,ID,PublicIPv4,PrivateIPv4 --no-header 2>/dev/null |
		awk -v n="$1" '$1==n{print $2, $3, $4; exit}')"
	if [ -n "$line" ]; then
		log_info "droplet $1: adopting existing"
	else
		log_info "droplet $1: creating ($2, image $3)"
		line="$(doctl compute droplet create "$1" --region "$DO_REGION" --size "$2" --image "$3" \
			--ssh-keys "$SSH_KEY_ID" --vpc-uuid "$DO_VPC_ID" --wait \
			--format ID,PublicIPv4,PrivateIPv4 --no-header)"
	fi
	printf '%s' "$line"
}

# Attach volume $1 to droplet $2. Skips if already on the target; hard-errors if
# attached to a DIFFERENT droplet (shouldn't happen — stop destroys droplets, so
# volumes come back detached; a mismatch means something is off, so fail loudly).
attach_volume() { # vol-id droplet-id
	attached="$(doctl compute volume get "$1" --format DropletIDs --no-header 2>/dev/null | tr -d '[]", ')"
	if [ -z "$attached" ]; then
		log_info "attaching volume $1 → droplet $2"
		doctl compute volume-action attach "$1" "$2" --wait >/dev/null
	elif [ "$attached" = "$2" ]; then
		log_info "volume $1 already attached to $2"
	else
		log_error "volume $1 is attached to a different droplet ($attached) — refusing to reattach."
		return 1
	fi
}

# Map the deployment env to DigitalOcean's Project `environment` enum (F13, #30).
_do_project_environment() {
	case "$DEPLOY_ENV" in
	prod) printf 'Production' ;;
	staging) printf 'Staging' ;;
	*) printf 'Development' ;;
	esac
}

# Ensure a DO Project named $1 exists (adopt-by-name, else create). Echoes its ID,
# or nothing on failure. Projects group resources in the DO console/billing (#30);
# create needs a purpose (required by doctl) + the env-mapped `environment` badge.
ensure_project() { # name
	id="$(doctl projects list --format ID,Name --no-header 2>/dev/null | awk -v n="$1" '$2==n{print $1; exit}')"
	if [ -n "$id" ]; then
		log_info "project $1: adopting existing ($id)"
	else
		log_info "project $1: creating"
		id="$(doctl projects create --name "$1" \
			--purpose 'Provisioned by the digital-ocean CLI' \
			--environment "$(_do_project_environment)" \
			--format ID --no-header 2>/dev/null)" || return 1
	fi
	printf '%s' "$id"
}

# Group the provisioned droplets + volumes under the per-app/env DO Project (#30).
# BEST-EFFORT: a token without `project` scope (cf. #16's missing firewall scope)
# must NOT fail an already-billable provision — the resources still work in the
# default project, so a failure here only warns. Assigns one resource per call
# (zsh has no word-splitting, so a single multi-flag string wouldn't expand).
_group_into_project() {
	pid="$(ensure_project "$_name_prefix")" || pid=""
	if [ -z "$pid" ]; then
		log_error "could not create/adopt DO Project '$_name_prefix' — leaving resources in the default project (token may lack 'project' scope). Continuing."
		return 0
	fi
	DO_PROJECT_ID="$pid"
	DO_PROJECT_NAME="$_name_prefix"
	write_state
	_assign_ok=1
	for urn in \
		"do:droplet:$DO_CPU_DROPLET_ID" \
		"do:droplet:$DO_GPU_DROPLET_ID" \
		"do:volume:$DO_DATA_VOLUME_ID" \
		"do:volume:$DO_MODELS_VOLUME_ID"; do
		doctl projects resources assign "$pid" --resource "$urn" >/dev/null 2>&1 || _assign_ok=0
	done
	if [ "$_assign_ok" = 1 ]; then
		log_info "assigned droplets + volumes to project '$DO_PROJECT_NAME' ($pid)"
	else
		log_error "some resources could not be assigned to project '$DO_PROJECT_NAME' — they remain in the default project. Continuing."
	fi
}

# Rewrite .do/state from the current DO_* vars (atomic, private perms). Called
# after each ensure step so state never claims a resource that wasn't made.
write_state() {
	mkdir -p "$CONFIG_DIR"
	old_umask="$(umask)"
	umask 077
	tmp="$DO_STATE_FILE.tmp.$$"
	{
		printf '# digital-ocean state — written by "digital-ocean provision" (F6). Gitignored; do not commit.\n'
		# The DO Project the resources are grouped under (F13, #30). Empty on a bare
		# provision that predates project grouping, or when the token lacks project scope.
		_kv DO_PROJECT_ID "${DO_PROJECT_ID:-}"
		_kv DO_PROJECT_NAME "${DO_PROJECT_NAME:-}"
		_kv DO_VPC_ID "${DO_VPC_ID:-}"
		_kv DO_VPC_NAME "${DO_VPC_NAME:-}"
		_kv DO_DATA_VOLUME_ID "${DO_DATA_VOLUME_ID:-}"
		_kv DO_DATA_VOLUME_NAME "${DO_DATA_VOLUME_NAME:-}"
		_kv DO_MODELS_VOLUME_ID "${DO_MODELS_VOLUME_ID:-}"
		_kv DO_MODELS_VOLUME_NAME "${DO_MODELS_VOLUME_NAME:-}"
		_kv DO_CPU_DROPLET_ID "${DO_CPU_DROPLET_ID:-}"
		_kv DO_CPU_PUBLIC_IP "${DO_CPU_PUBLIC_IP:-}"
		_kv DO_CPU_PRIVATE_IP "${DO_CPU_PRIVATE_IP:-}"
		_kv DO_GPU_DROPLET_ID "${DO_GPU_DROPLET_ID:-}"
		_kv DO_GPU_PUBLIC_IP "${DO_GPU_PUBLIC_IP:-}"
		_kv DO_GPU_PRIVATE_IP "${DO_GPU_PRIVATE_IP:-}"
		# Firewall IDs are set by F7 `start` (empty on a bare F6 provision).
		_kv DO_CPU_FW_ID "${DO_CPU_FW_ID:-}"
		_kv DO_GPU_FW_ID "${DO_GPU_FW_ID:-}"
		# The deployed app's port + health path (F11, #27) — set by `start` from the
		# manifest, empty on a bare `provision`. F9 status/logs read them from here so
		# those debug helpers stay manifest-free.
		_kv APP_PORT "${APP_PORT:-}"
		_kv APP_HEALTH_PATH "${APP_HEALTH_PATH:-}"
		# The public HTTPS URL (F14, #31) — set by `start` once Caddy is up; empty on a
		# bare `provision`. `status` surfaces it (#36) so it's discoverable later.
		_kv APP_URL "${APP_URL:-}"
	} >"$tmp"
	mv "$tmp" "$DO_STATE_FILE"
	umask "$old_umask"
}

# Resolve one infra field with precedence: env/config var > manifest deployment >
# built-in default (F12, #29). VARNAME is the shell/env var (also the config-file
# key); MANIFEST_KEY is its name under deployments.<env>. When an env/config value
# overrides a manifest-provided one, log it (source + old→new) so an unexpected
# region/size is easy to trace. Uses eval for indirection (no bash arrays — zsh-safe).
_resolve_field() { # varname manifest_key default
	_rf_var="$1"
	_rf_key="$2"
	_rf_def="$3"
	eval "_rf_env=\"\${$_rf_var:-}\""
	_rf_man="$(_manifest_get_deployment "$MANIFEST" "$DEPLOY_ENV" "$_rf_key")"
	if [ -n "$_rf_env" ]; then
		if [ -n "$_rf_man" ] && [ "$_rf_env" != "$_rf_man" ]; then
			log_info "$_rf_key: using '$_rf_env' ($_rf_var overrides manifest '$_rf_man')"
		fi
		eval "$_rf_var=\"\$_rf_env\""
	elif [ -n "$_rf_man" ]; then
		eval "$_rf_var=\"\$_rf_man\""
	else
		eval "$_rf_var=\"\$_rf_def\""
	fi
}

# Load .do/config + the app manifest, then resolve the per-env infra (F12, #29).
# The MANIFEST (deployments.<env>) is the source of truth for region/backend/sizes/
# firewall; .do/config now carries only machine-local facts (DO_SSH_KEY_NAME,
# APP_CREDENTIALS_FILE). Precedence per field: env/config var > manifest > default.
# Requires --app-dir (via _load_manifest) — so does its caller `start`.
_provision_load_config() {
	if [ ! -f "$CONFIG_FILE" ]; then
		log_error "no config at $CONFIG_FILE — run 'digital-ocean setup' first."
		return 1
	fi
	log_debug "loading config $CONFIG_FILE"
	# shellcheck disable=SC1090
	. "$CONFIG_FILE"

	# The manifest supplies APP_NAME (the resource-name prefix) + the per-env infra
	# block. This makes --app-dir required for provision/start.
	_load_manifest || return $?

	# Ollama backend (#18) — resolved before the region, which is derived from it
	# (#17). NB the APP node is always CPU; only the OLLAMA node varies cpu/gpu,
	# hence the manifest key `ollama_backend`.
	_resolve_field OLLAMA_BACKEND ollama_backend cpu
	if [ "$OLLAMA_BACKEND" != cpu ] && [ "$OLLAMA_BACKEND" != gpu ]; then
		log_error "ollama_backend must be 'cpu' or 'gpu' (got '$OLLAMA_BACKEND')."
		return 1
	fi
	# Region is backend-aware (#17, ADR-0008): cpu→blr1, gpu→tor1 — the default when
	# the manifest omits `region`.
	_resolve_field DO_REGION region "$(_region_for_backend "$OLLAMA_BACKEND")"
	_resolve_field DO_CPU_SIZE app_size s-2vcpu-4gb
	_resolve_field DO_GPU_SIZE ollama_gpu_size gpu-6000adax1-48gb
	_resolve_field DO_OLLAMA_CPU_SIZE ollama_cpu_size s-8vcpu-16gb-amd
	# Firewall (#19): manifest may say true/false; normalize to the internal 1/0.
	_resolve_field DO_ENABLE_FIREWALL firewall 0
	case "$DO_ENABLE_FIREWALL" in
	1 | true | TRUE | True | yes | on) DO_ENABLE_FIREWALL=1 ;;
	*) DO_ENABLE_FIREWALL=0 ;;
	esac

	# Default so a config missing this key gives the clean "key not found" error
	# below rather than a set -u "unbound variable" crash.
	DO_SSH_KEY_NAME="${DO_SSH_KEY_NAME:-}"
	# Resource names — derived from <name>-<env> (#29), still env-overridable.
	# VPC name keeps its region suffix (#17): a DO VPC is bound to one region, so a
	# same-named VPC in another region would be adopted then fail droplet create
	# ("Failed to resolve VPC"). <name>-<env>-vpc-<region> gives each its own.
	_name_prefix="${APP_NAME}-${DEPLOY_ENV}"
	DO_VPC_NAME="${DO_VPC_NAME:-${_name_prefix}-vpc-$DO_REGION}"
	DO_DATA_VOLUME_NAME="${DO_DATA_VOLUME_NAME:-${_name_prefix}-data}"
	DO_MODELS_VOLUME_NAME="${DO_MODELS_VOLUME_NAME:-${_name_prefix}-models}"
	DO_CPU_NAME="${DO_CPU_NAME:-${_name_prefix}-backend}"
	# The ollama node's name suffix tracks its backend (#29): -ollama-cpu / -ollama-gpu.
	DO_GPU_NAME="${DO_GPU_NAME:-${_name_prefix}-ollama-$OLLAMA_BACKEND}"
	# Volume sizes in GiB (ADR-0003 defaults).
	DO_DATA_SIZE="${DO_DATA_SIZE:-10}"
	DO_MODELS_SIZE="${DO_MODELS_SIZE:-50}"
	# Droplet images. Both are plain stock Ubuntu: there is no public RTX-6000-Ada
	# base image, so the GPU node boots plain Ubuntu and provision-gpu.sh installs
	# the NVIDIA driver itself (#17, ADR-0002). Override via DO_CPU/GPU_IMAGE.
	DO_CPU_IMAGE="${DO_CPU_IMAGE:-ubuntu-22-04-x64}"
	DO_GPU_IMAGE="${DO_GPU_IMAGE:-ubuntu-22-04-x64}"

	# The "Ollama node" is the DO_GPU_* droplet regardless of backend (the state
	# keys stay DO_GPU_* — see design/overview.md). In cpu mode it's a plain CPU
	# droplet (DO_OLLAMA_CPU_SIZE, stock Ubuntu image); in gpu mode a GPU droplet.
	if [ "$OLLAMA_BACKEND" = gpu ]; then
		DO_OLLAMA_NODE_SIZE="$DO_GPU_SIZE"
		DO_OLLAMA_NODE_IMAGE="$DO_GPU_IMAGE"
	else
		DO_OLLAMA_NODE_SIZE="$DO_OLLAMA_CPU_SIZE"
		DO_OLLAMA_NODE_IMAGE="$DO_CPU_IMAGE"
	fi
}

cmd_provision() {
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'provision': $1"
		usage >&2
		return 2
	fi

	_provision_load_config || return 1

	log_info "Provisioning DO resources in $DO_REGION — this CREATES BILLABLE resources."

	# Resolve the SSH key up front so a bad key name fails BEFORE anything bills.
	SSH_KEY_ID="$(_resolve_ssh_key "$DO_SSH_KEY_NAME")"
	if [ -z "$SSH_KEY_ID" ]; then
		log_error "DO SSH key '$DO_SSH_KEY_NAME' not found (doctl compute ssh-key list)."
		log_error "Fix DO_SSH_KEY_NAME in $CONFIG_FILE, or import it: doctl compute ssh-key import <name> --public-key-file ~/.ssh/id_ed25519.pub"
		return 1
	fi

	DO_VPC_ID="$(ensure_vpc "$DO_VPC_NAME")"
	write_state

	DO_DATA_VOLUME_ID="$(ensure_volume "$DO_DATA_VOLUME_NAME" "$DO_DATA_SIZE")"
	DO_MODELS_VOLUME_ID="$(ensure_volume "$DO_MODELS_VOLUME_NAME" "$DO_MODELS_SIZE")"
	write_state

	cpu_line="$(ensure_droplet "$DO_CPU_NAME" "$DO_CPU_SIZE" "$DO_CPU_IMAGE")"
	DO_CPU_DROPLET_ID="$(printf '%s' "$cpu_line" | awk '{print $1}')"
	DO_CPU_PUBLIC_IP="$(printf '%s' "$cpu_line" | awk '{print $2}')"
	DO_CPU_PRIVATE_IP="$(printf '%s' "$cpu_line" | awk '{print $3}')"
	gpu_line="$(ensure_droplet "$DO_GPU_NAME" "$DO_OLLAMA_NODE_SIZE" "$DO_OLLAMA_NODE_IMAGE")"
	DO_GPU_DROPLET_ID="$(printf '%s' "$gpu_line" | awk '{print $1}')"
	DO_GPU_PUBLIC_IP="$(printf '%s' "$gpu_line" | awk '{print $2}')"
	DO_GPU_PRIVATE_IP="$(printf '%s' "$gpu_line" | awk '{print $3}')"
	write_state

	# data → CPU, models → GPU (ADR-0003).
	attach_volume "$DO_DATA_VOLUME_ID" "$DO_CPU_DROPLET_ID"
	attach_volume "$DO_MODELS_VOLUME_ID" "$DO_GPU_DROPLET_ID"
	write_state

	# Group everything under the per-app/env DO Project (F13, #30). Best-effort:
	# never fails the (already-billable) provision — see _group_into_project.
	_group_into_project

	log_info "Provisioned. CPU $DO_CPU_PUBLIC_IP (private $DO_CPU_PRIVATE_IP), GPU $DO_GPU_PUBLIC_IP (private $DO_GPU_PRIVATE_IP)."
	log_info "State recorded at $DO_STATE_FILE"
	# stdout carries the state path only (data), per the logging convention.
	echo "$DO_STATE_FILE"
}

# --- `digital-ocean stop` / `destroy` (F8) ----------------------------------
# The public teardown surface (replaces the old hidden `deprovision`). `stop`
# destroys the droplets + firewalls but KEEPS the volumes + VPC so a later
# `start` re-adopts the data; `destroy` also removes the volumes + VPC (all data
# lost) behind a confirmation prompt. Both share `_teardown`. Snapshots: we never
# create any, so there is nothing to delete — forward-looking (see design).

# How long to wait for an async droplet delete to actually complete before giving
# up, and how often to poll. Overridable so tests run fast.
DO_DELETE_WAIT_SECS="${DO_DELETE_WAIT_SECS:-120}"
DO_DELETE_POLL_SLEEP="${DO_DELETE_POLL_SLEEP:-5}"

# True once `doctl` reports the droplet no longer exists.
_droplet_gone() { # id
	! doctl compute droplet get "$1" >/dev/null 2>&1
}

# Delete both droplets, then WAIT until each is really gone. DO droplet deletion
# is async: returning early leaves the volumes still detaching, so a follow-on
# `volume delete` fails (#7 Bug 1). Polling until the droplet disappears means the
# volumes are detached before we touch them. Best-effort per resource.
_delete_droplets_wait() {
	pending=""
	for d in "${DO_CPU_DROPLET_ID:-}" "${DO_GPU_DROPLET_ID:-}"; do
		if [ -n "$d" ]; then
			log_info "destroying droplet $d"
			doctl compute droplet delete "$d" --force >/dev/null 2>&1 || log_error "failed to delete droplet $d"
			pending="$pending $d"
		fi
	done
	for d in $pending; do
		waited=0
		while ! _droplet_gone "$d"; do
			if [ "$waited" -ge "$DO_DELETE_WAIT_SECS" ]; then
				log_error "droplet $d still present after ${DO_DELETE_WAIT_SECS}s — continuing anyway"
				break
			fi
			log_info "waiting for droplet $d to finish deleting…"
			sleep "$DO_DELETE_POLL_SLEEP"
			waited=$((waited + DO_DELETE_POLL_SLEEP))
		done
	done
	DO_CPU_DROPLET_ID=""
	DO_CPU_PUBLIC_IP=""
	DO_CPU_PRIVATE_IP=""
	DO_GPU_DROPLET_ID=""
	DO_GPU_PUBLIC_IP=""
	DO_GPU_PRIVATE_IP=""
}

# Delete the two `start`-created cloud firewalls if present (a bare provision or a
# firewall-disabled run records none — then this is a no-op). Best-effort.
_delete_firewalls() {
	for fw in "${DO_CPU_FW_ID:-}" "${DO_GPU_FW_ID:-}"; do
		if [ -n "$fw" ]; then
			log_info "destroying firewall $fw"
			doctl compute firewall delete "$fw" --force >/dev/null 2>&1 || log_error "failed to delete firewall $fw"
		fi
	done
	DO_CPU_FW_ID=""
	DO_GPU_FW_ID=""
}

# Delete both volumes (called only by `destroy`, after droplets are gone so the
# volumes have detached). Best-effort per resource.
_delete_volumes() {
	for v in "${DO_DATA_VOLUME_ID:-}" "${DO_MODELS_VOLUME_ID:-}"; do
		if [ -n "$v" ]; then
			log_info "destroying volume $v"
			doctl compute volume delete "$v" --force >/dev/null 2>&1 || log_error "failed to delete volume $v"
		fi
	done
	DO_DATA_VOLUME_ID=""
	DO_MODELS_VOLUME_ID=""
}

# Delete the VPC, tolerating a non-deletable default VPC (#7 Bug 2). On this
# account the created VPC was auto-promoted to the region default, so `vpcs
# delete` returns 403 "Can not delete default VPCs". A default VPC is free and
# expected, so we skip-with-warning rather than erroring.
_delete_vpc() {
	[ -n "${DO_VPC_ID:-}" ] || return 0
	log_info "destroying vpc $DO_VPC_ID"
	if out="$(doctl vpcs delete "$DO_VPC_ID" --force 2>&1)"; then
		DO_VPC_ID=""
		return 0
	fi
	case "$out" in
	*[Dd]efault*VPC* | *"default VPCs"* | *403*)
		log_info "vpc $DO_VPC_ID is a default VPC (free, non-deletable) — leaving it in place."
		;;
	*)
		log_error "failed to delete vpc $DO_VPC_ID: $out"
		;;
	esac
}

# Shared teardown core. with_volumes=1 → full destroy (volumes + VPC + state
# file); 0 → stop (keep volumes + VPC, rewrite pruned state). Callers have
# already confirmed a state file exists.
_teardown() { # with_volumes(0|1)
	with_volumes="$1"
	# shellcheck disable=SC1090
	. "$DO_STATE_FILE"

	_delete_droplets_wait
	_delete_firewalls

	if [ "$with_volumes" -eq 1 ]; then
		_delete_volumes
		_delete_vpc
		rm -f "$DO_STATE_FILE"
		log_info "destroyed droplets + firewalls + volumes + VPC. Removed $DO_STATE_FILE"
		return 0
	fi

	write_state
	log_info "stopped: destroyed droplets + firewalls. Volumes + VPC kept — state at $DO_STATE_FILE"
}

cmd_stop() {
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'stop': $1"
		usage >&2
		return 2
	fi
	if [ ! -f "$DO_STATE_FILE" ]; then
		log_info "no state at $DO_STATE_FILE — nothing to stop."
		return 0
	fi
	_teardown 0
}

cmd_destroy() {
	ASSUME_YES=0
	while [ $# -gt 0 ]; do
		case "$1" in
		-y | --non-interactive)
			ASSUME_YES=1
			shift
			;;
		*)
			log_error "unknown argument to 'destroy': $1"
			usage >&2
			return 2
			;;
		esac
	done

	if [ ! -f "$DO_STATE_FILE" ]; then
		log_info "no state at $DO_STATE_FILE — nothing to destroy."
		return 0
	fi

	if [ "$ASSUME_YES" -ne 1 ]; then
		printf 'This DESTROYS droplets, firewalls, volumes and the VPC — all data is lost. Type "yes" to confirm: ' >&2
		IFS= read -r reply || reply=""
		case "$reply" in
		yes | YES | y | Y) ;;
		*)
			log_info "destroy aborted — nothing deleted."
			return 1
			;;
		esac
	fi
	_teardown 1
}

# --- `digital-ocean start` (F7) ---------------------------------------------
# The public end-to-end orchestration: load the app manifest (--app-dir) →
# provision (reuse F6) → firewalls → wait for SSH → sync code → run F5 provision
# scripts over SSH → ollama pull → scp creds → deploy the app as a systemd unit
# (the explicit manifest env contract, private Ollama URL — F11/#27) → health
# checks → print the public URL + ready-to-paste ssh commands. Idempotent: a
# re-run adopts every resource, re-syncs, and restarts the service.

# Where `start` pins droplet host keys (accept-new on first connect, then verify).
KNOWN_HOSTS="$CONFIG_DIR/known_hosts"
# Waits (overridable so tests run fast). SSH: fresh droplets take a bit to boot.
DO_SSH_WAIT_SECS="${DO_SSH_WAIT_SECS:-180}"
DO_HEALTH_WAIT_SECS="${DO_HEALTH_WAIT_SECS:-120}"

# Standard SSH options: batch (never prompt), accept-new host keys into our pinned
# known_hosts, a bounded connect timeout, and keepalives so a STALLED connection
# is torn down (ServerAliveInterval*CountMax ≈ 60s) instead of hanging forever — a
# fresh droplet's sshd can stall mid-transfer during cloud-init. A resolved local
# key is added if we find one; otherwise we fall back to the agent/default identities.
_ssh_opts() {
	printf '%s' "-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$KNOWN_HOSTS -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
	keyfile="$(_local_ssh_key || true)"
	[ -n "$keyfile" ] && printf ' %s' "-i $keyfile"
}

# _retry N CMD... — run CMD up to N times with a short backoff, returning success
# on the first pass. Used to ride out fresh-droplet transients (sshd restarting
# under cloud-init) that make an early rsync reset or stall; every retried step is
# idempotent, so a re-attempt is always safe.
_retry() { # count cmd...
	tries="$1"; shift
	i=1
	while true; do
		if "$@"; then return 0; fi
		if [ "$i" -ge "$tries" ]; then
			log_error "still failing after $tries attempts: $*"
			return 1
		fi
		log_info "attempt $i/$tries failed; retrying in ${DO_RETRY_SLEEP:-5}s: $1"
		sleep "${DO_RETRY_SLEEP:-5}"
		i=$((i + 1))
	done
}

# _ssh HOST REMOTE-COMMAND — run one (single-line) command as root on HOST.
# The unquoted $(_ssh_opts) is deliberate: it must word-split into separate ssh
# flags, and this file avoids arrays (runs under bash and zsh). $2 expands on the
# client (SC2029) by design — the remote command is built only from our own vars.
_ssh() { # host command
	# shellcheck disable=SC2046,SC2086,SC2029
	ssh $(_ssh_opts) "root@$1" "$2"
}

# _scp LOCAL HOST:REMOTE — copy a local file to a droplet.
_scp() { # local remote
	# shellcheck disable=SC2046,SC2086
	scp $(_ssh_opts) "$1" "$2"
}

# _rsync LOCAL... HOST:DIR — sync local trees to a droplet over ssh. Excludes the
# Mac-local runtime cruft (venv, pycache, LOCAL run data) so only source ships.
_rsync() { # local... remote
	# NO --delete-excluded: a Homebrew rsync (3.2.7) sending it to Ubuntu's rsync
	# (3.2.3) overflows the receiver's rule buffer (exclude.c recv_rules) and kills
	# the remote — a cross-version filter-rule incompatibility. It isn't needed here
	# (droplets are ephemeral so /opt/app starts empty, and the --exclude list
	# already keeps cruft out of the transfer). --timeout=120 aborts a stalled
	# transfer instead of hanging; callers wrap this in _retry to ride out a
	# fresh-boot reset.
	# shellcheck disable=SC2086
	rsync -az --timeout=120 \
		--exclude='.venv' --exclude='__pycache__' --exclude='*.pyc' \
		--exclude='.localdata' --exclude='.pytest_cache' \
		-e "ssh $(_ssh_opts)" "$@"
}

# Poll until SSH answers on HOST, up to DO_SSH_WAIT_SECS. Fresh droplets need a
# moment before sshd is up; a bad key or blocked port fails the whole start here.
_wait_ssh() { # host
	waited=0
	mkdir -p "$CONFIG_DIR"
	while true; do
		if _ssh "$1" "true" >/dev/null 2>&1; then
			log_info "ssh up on $1"
			return 0
		fi
		if [ "$waited" -ge "$DO_SSH_WAIT_SECS" ]; then
			log_error "ssh never became reachable on $1 after ${DO_SSH_WAIT_SECS}s"
			return 1
		fi
		log_debug "waiting for ssh on $1 (${waited}s)"
		sleep 1
		waited=$((waited + 1))
	done
}

# Ensure a DO cloud firewall named $1 with the given inbound rules exists (adopt by
# name, else create). Outbound is allow-all — a firewall with NO outbound rules
# blocks ALL egress, which would break apt/pip/ollama installs. Echoes the ID.
FW_OUTBOUND_ALL="protocol:tcp,ports:all,address:0.0.0.0/0,address:::/0 protocol:udp,ports:all,address:0.0.0.0/0,address:::/0 protocol:icmp,address:0.0.0.0/0,address:::/0"
ensure_firewall() { # name inbound-rules
	id="$(doctl compute firewall list --format Name,ID --no-header 2>/dev/null | awk -v n="$1" '$1==n{print $2; exit}')"
	if [ -n "$id" ]; then
		log_info "firewall $1: adopting existing ($id)"
	else
		log_info "firewall $1: creating"
		id="$(doctl compute firewall create --name "$1" \
			--inbound-rules "$2" --outbound-rules "$FW_OUTBOUND_ALL" \
			--format ID --no-header 2>/dev/null)"
		if [ -z "$id" ]; then
			log_error "firewall $1: create failed — the doctl token likely lacks firewall scope (#16)."
			log_error "Set DO_ENABLE_FIREWALL=0 to run without it: Ollama is already off the public net via its private-IP bind (#19)."
			return 1
		fi
	fi
	printf '%s' "$id"
}

# Assign droplet $2 to firewall $1 (idempotent — DO ignores a droplet already on it).
# Hard-fails on error: a firewall that never took effect is a security gap (Ollama
# left open / app unreachable), not something to log-and-continue past.
assign_firewall() { # fw-id droplet-id
	if ! doctl compute firewall add-droplets "$1" --droplet-ids "$2" >/dev/null 2>&1; then
		log_error "could not assign droplet $2 to firewall $1"
		return 1
	fi
}

cmd_start() {
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'start': $1"
		usage >&2
		return 2
	fi

	# 0. Learn the app from its manifest (--app-dir) BEFORE provisioning anything —
	#    a bad/missing manifest must fail before a single billable resource is made.
	_load_manifest || return $?

	# 1. Provision (reuse F6). This sets DO_* resource vars in our scope and writes
	#    .do/state; its stdout (the state path) is data we don't want in start's.
	if ! cmd_provision >/dev/null; then
		return 1
	fi
	# Re-read state so IPs/IDs are explicit (and to decouple from provision internals).
	# shellcheck disable=SC1090
	. "$DO_STATE_FILE"

	# 2. Firewalls (OPTIONAL — #19). Ollama is kept off the public net by its
	# private-IP bind (step 5), so a DO firewall is defense-in-depth, default off.
	# Enabling it needs a firewall-scoped token (#16); skipping it lets `start` run
	# on the current token.
	if [ "$DO_ENABLE_FIREWALL" = 1 ]; then
		log_info "Securing with DO cloud firewalls (DO_ENABLE_FIREWALL=1)."
		# CPU: app + ssh public. GPU/Ollama node: :11434 only from inside the VPC.
		# The Ollama rule MUST be scoped to the VPC range — if we can't resolve it,
		# fail rather than fall back to a rule that would expose Ollama.
		vpc_range="$(doctl vpcs get "$DO_VPC_ID" --format IPRange --no-header 2>/dev/null)"
		if [ -z "$vpc_range" ]; then
			log_error "could not resolve the VPC IP range for $DO_VPC_ID — refusing to open Ollama without it."
			return 1
		fi
		# F14 (#31): expose the HTTPS ports (443 + 80 for ACME/redirect), NOT the app
		# port — the app is loopback-only behind Caddy.
		DO_CPU_FW_ID="$(ensure_firewall "${DO_CPU_NAME}-fw" \
			"protocol:tcp,ports:443,address:0.0.0.0/0,address:::/0 protocol:tcp,ports:80,address:0.0.0.0/0,address:::/0 protocol:tcp,ports:22,address:0.0.0.0/0,address:::/0")" || return 1
		DO_GPU_FW_ID="$(ensure_firewall "${DO_GPU_NAME}-fw" \
			"protocol:tcp,ports:11434,address:$vpc_range protocol:tcp,ports:22,address:0.0.0.0/0,address:::/0")" || return 1
		assign_firewall "$DO_CPU_FW_ID" "$DO_CPU_DROPLET_ID" || return 1
		assign_firewall "$DO_GPU_FW_ID" "$DO_GPU_DROPLET_ID" || return 1
	else
		log_info "Skipping DO firewalls (DO_ENABLE_FIREWALL=0); Ollama stays private via its VPC-IP bind (#19)."
	fi
	write_state

	# 3. Wait for SSH on both droplets before touching them.
	log_info "Waiting for SSH on both droplets."
	_wait_ssh "$DO_CPU_PUBLIC_IP" || return 1
	_wait_ssh "$DO_GPU_PUBLIC_IP" || return 1

	# 4. Sync the app code + provisioning scripts on both hosts (F11, #27): the app
	# CODE always lands at /opt/app/app (the trailing slash on the source syncs its
	# contents in, independent of the source dir's name), and the tool-owned infra/
	# at /opt/app/infra. A fresh droplet's sshd can reset or stall the first
	# transfers while cloud-init runs, so retry each step (all idempotent).
	log_info "Syncing the app → /opt/app/app and infra/ → /opt/app on both droplets."
	for ip in "$DO_CPU_PUBLIC_IP" "$DO_GPU_PUBLIC_IP"; do
		_retry 5 _ssh "$ip" "mkdir -p /opt/app/app" || return 1
		_retry 5 _rsync "$APP_CODE_DIR/" "root@$ip:/opt/app/app/" || return 1
		_retry 5 _rsync "$REPO_ROOT/infra" "root@$ip:/opt/app/" || return 1
	done

	# 5. Ollama node: provision (F5), then pull the model (C8 — persists on
	# /mnt/models). Bind Ollama to the node's PRIVATE VPC IP (#19) so :11434 is off
	# the public net with no firewall. The provisioning script depends on the
	# backend (#18): CPU (plain Ubuntu, no NVIDIA) vs GPU. `ollama pull` must use
	# the same private host — the CLI otherwise defaults to loopback.
	ollama_bind="$DO_GPU_PRIVATE_IP:11434"
	if [ "$OLLAMA_BACKEND" = gpu ]; then
		log_info "Provisioning GPU Ollama node + pulling model '$APP_OLLAMA_MODEL'."
		_ssh "$DO_GPU_PUBLIC_IP" \
			"MODELS_VOLUME_NAME=$DO_MODELS_VOLUME_NAME OLLAMA_HOST=$ollama_bind bash /opt/app/infra/provision-gpu.sh" || return 1
	else
		log_info "Provisioning CPU Ollama node + pulling model '$APP_OLLAMA_MODEL'."
		_ssh "$DO_GPU_PUBLIC_IP" \
			"MODELS_VOLUME_NAME=$DO_MODELS_VOLUME_NAME OLLAMA_HOST=$ollama_bind bash /opt/app/infra/provision-ollama-cpu.sh" || return 1
	fi
	_ssh "$DO_GPU_PUBLIC_IP" "OLLAMA_HOST=$ollama_bind ollama pull $APP_OLLAMA_MODEL" || return 1

	# 6. CPU: provision (F5) with the manifest's requirements at the app's
	#    /opt/app/app location, (optionally) copy creds (C9/ADR-0005), then deploy
	#    the app (C10) as a systemd unit wired to the GPU's PRIVATE Ollama URL (ADR-0007).
	log_info "Provisioning CPU droplet + deploying the app."
	_ssh "$DO_CPU_PUBLIC_IP" \
		"DATA_VOLUME_NAME=$DO_DATA_VOLUME_NAME REQUIREMENTS_FILE=/opt/app/app/$APP_REQUIREMENTS_REL bash /opt/app/infra/provision-cpu.sh" || return 1
	# Credentials channel (ADR-0005) is opt-in per the manifest (credentials_env_file).
	# When on, ship the local creds file to /etc/app/credentials; the systemd unit
	# loads it as an EnvironmentFile (see _deploy_app).
	if [ "$APP_CREDS_ENV" = 1 ]; then
		_ssh "$DO_CPU_PUBLIC_IP" "mkdir -p /etc/app" || return 1
		_scp "$APP_CREDENTIALS_FILE" "root@$DO_CPU_PUBLIC_IP:/etc/app/credentials" || return 1
	fi
	_deploy_app "$DO_CPU_PUBLIC_IP" "$DO_GPU_PRIVATE_IP" || return 1

	# 7. Health checks (C11): Ollama reachable over the PRIVATE IP from the CPU,
	#    then the app answers /health. Not healthy = not Done.
	log_info "Running health checks."
	if ! _ssh "$DO_CPU_PUBLIC_IP" "curl -fsS --max-time 5 http://$DO_GPU_PRIVATE_IP:11434/api/tags >/dev/null"; then
		log_error "Ollama not reachable at $DO_GPU_PRIVATE_IP:11434 from the CPU droplet (VPC/firewall?)."
		return 1
	fi
	if ! _wait_app_health "$DO_CPU_PUBLIC_IP"; then
		log_error "app health check never passed on $DO_CPU_PUBLIC_IP:$APP_PORT$APP_HEALTH_PATH"
		return 1
	fi

	# 8. HTTPS (F14, #31): front the app with Caddy on a <dashed-ip>.sslip.io host so
	#    the browser gets a secure origin (mic works) via a trusted Let's Encrypt cert.
	#    Fail hard — no insecure http fallback (the "not healthy = not Done" discipline).
	APP_TLS_HOSTNAME="$(_sslip_hostname "$DO_CPU_PUBLIC_IP")"
	APP_URL="https://$APP_TLS_HOSTNAME"
	# DO_TLS_ACME_STAGING=1 → use the Let's Encrypt STAGING CA (untrusted, high rate
	# limits) while iterating; unset → production LE (a trusted cert, the default).
	tls_acme_env=""
	if [ "${DO_TLS_ACME_STAGING:-0}" = 1 ]; then
		tls_acme_env="ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory "
	fi
	log_info "Provisioning HTTPS (Caddy + $APP_TLS_HOSTNAME + Let's Encrypt)."
	_ssh "$DO_CPU_PUBLIC_IP" \
		"${tls_acme_env}TLS_HOSTNAME=$APP_TLS_HOSTNAME APP_PORT=$APP_PORT bash /opt/app/infra/provision-caddy.sh" || return 1
	# TLS gate: confirm Caddy actually serves the app over https on the sslip.io host.
	# `-k` tolerates the staging cert here; the trusted-cert assertion is the live
	# VERIFY (a real browser + plain curl). Give ACME a moment to issue the cert.
	if ! _wait_tls_health "$DO_CPU_PUBLIC_IP" "$APP_TLS_HOSTNAME"; then
		log_error "HTTPS never came up at $APP_URL$APP_HEALTH_PATH (Caddy/ACME?)"
		return 1
	fi
	# Record the public HTTPS URL now that TLS is confirmed up.
	write_state

	log_info "App is up."
	# stdout carries the public HTTPS URL + ready-to-paste ssh commands (data; ADR-0006).
	echo "$APP_URL"
	echo "ssh root@$DO_CPU_PUBLIC_IP   # CPU droplet (app)"
	echo "ssh root@$DO_GPU_PUBLIC_IP   # GPU droplet (Ollama)"
}

# Map a droplet IP to its sslip.io hostname: 64.227.154.8 → 64-227-154-8.sslip.io
# (a single DNS label, so it's a valid cert SAN). sslip.io is wildcard DNS that
# encodes the IP in the name — trusted HTTPS with no owned domain (F14, #31).
_sslip_hostname() { # ip
	printf '%s.sslip.io' "$(printf '%s' "$1" | tr '.' '-')"
}

# Poll the app's health endpoint over HTTPS (through Caddy) on the sslip.io host,
# from inside the CPU droplet, up to DO_HEALTH_WAIT_SECS. `-k` accepts a staging
# cert — this only proves Caddy is proxying + the TLS handshake works; trust is
# asserted at the live VERIFY.
_wait_tls_health() { # cpu-ip tls-hostname
	waited=0
	while true; do
		if _ssh "$1" "curl -fsSk --max-time 5 https://$2$APP_HEALTH_PATH >/dev/null" 2>/dev/null; then
			return 0
		fi
		if [ "$waited" -ge "$DO_HEALTH_WAIT_SECS" ]; then
			return 1
		fi
		sleep 1
		waited=$((waited + 1))
	done
}

# Write + enable the app's systemd unit on the CPU, wired to the GPU's private
# Ollama URL. The env is the explicit manifest contract (F11, #27) — HOST/PORT,
# the private Ollama URL + model, and the data dir — set directly, with NO
# app-specific APP_ENV. When credentials_env_file is on, systemd loads
# /etc/app/credentials as an EnvironmentFile (the `-` tolerates it being empty or
# absent), which is how per-app secrets (e.g. a third-party API key) reach the
# app. Kept a single ssh command (printf '%b' expands the \n escapes) so the whole
# unit ships in one round-trip and logs on one line.
_deploy_app() { # cpu-ip gpu-private-ip
	unit='[Unit]\n'
	unit="${unit}Description=hello-digital-ocean app ($APP_ENTRYPOINT)\n"
	unit="${unit}After=network-online.target\n\n"
	unit="${unit}[Service]\n"
	# F14 (#31): the app binds LOOPBACK — Caddy fronts it on :443/:80, so the plain
	# app port is never exposed on the public net.
	unit="${unit}Environment=HOST=127.0.0.1\n"
	unit="${unit}Environment=PORT=$APP_PORT\n"
	unit="${unit}Environment=OLLAMA_URL=http://$2:11434\n"
	unit="${unit}Environment=OLLAMA_MODEL=$APP_OLLAMA_MODEL\n"
	unit="${unit}Environment=APP_DATA_DIR=/mnt/data\n"
	if [ "$APP_CREDS_ENV" = 1 ]; then
		unit="${unit}EnvironmentFile=-/etc/app/credentials\n"
	fi
	unit="${unit}ExecStart=/opt/app/.venv/bin/python /opt/app/app/$APP_ENTRYPOINT\n"
	unit="${unit}Restart=on-failure\n\n"
	unit="${unit}[Install]\n"
	unit="${unit}WantedBy=multi-user.target\n"
	_ssh "$1" "printf '%b' '$unit' >/etc/systemd/system/app.service; systemctl daemon-reload; systemctl enable app.service; systemctl restart app.service"
}

# Poll the app's health endpoint from inside the CPU droplet up to DO_HEALTH_WAIT_SECS.
_wait_app_health() { # cpu-ip
	waited=0
	while true; do
		if _ssh "$1" "curl -fsS --max-time 5 http://127.0.0.1:$APP_PORT$APP_HEALTH_PATH >/dev/null" 2>/dev/null; then
			return 0
		fi
		if [ "$waited" -ge "$DO_HEALTH_WAIT_SECS" ]; then
			return 1
		fi
		sleep 1
		waited=$((waited + 1))
	done
}

# --- `digital-ocean ssh|logs|status` (F9) -----------------------------------
# Debug helpers. They reuse F7's non-interactive ssh surface (_ssh/_ssh_opts +
# the pinned known_hosts → StrictHostKeyChecking=accept-new, never a yes/no
# prompt) and the F6/F7 state file, so the CLI already knows the droplet IPs —
# the user names a role (cpu|gpu), not a host.

# Source the state file or fail with a pointer to `start`. Callers run this
# before touching any DO_*_PUBLIC_IP.
_load_state_or_die() {
	if [ ! -f "$DO_STATE_FILE" ]; then
		log_error "no infra state at $DO_STATE_FILE — run 'digital-ocean start' first."
		return 1
	fi
	# shellcheck disable=SC1090
	. "$DO_STATE_FILE"
}

# Resolve a role (cpu|gpu, default cpu) to "PUBLIC_IP UNIT HEALTH_URL".
# cpu → the app (app.service, :<APP_PORT><APP_HEALTH_PATH> from .do/state);
# gpu → the Ollama node (ollama.service, :11434/api/tags).
# Unknown role → exit 2 (usage error); empty/missing IP → exit 1.
_resolve_target() { # role
	role="${1:-cpu}"
	# The app port + health path come from .do/state (recorded by `start` from the
	# manifest, F11/#27); the fallback covers a bare `provision` with no app deployed.
	case "$role" in
	cpu) ip="${DO_CPU_PUBLIC_IP:-}"; unit="app.service"; health="http://127.0.0.1:${APP_PORT:-5000}${APP_HEALTH_PATH:-/health}" ;;
	gpu) ip="${DO_GPU_PUBLIC_IP:-}"; unit="ollama.service"; health="http://127.0.0.1:11434/api/tags" ;;
	*)
		log_error "unknown target '$role' (expected: cpu | gpu)"
		usage >&2
		return 2
		;;
	esac
	if [ -z "$ip" ]; then
		log_error "no public IP for the $role droplet in $DO_STATE_FILE — run 'digital-ocean start' first."
		return 1
	fi
	printf '%s %s %s' "$ip" "$unit" "$health"
}

cmd_ssh() {
	role="cpu"
	# A leading cpu|gpu selects the droplet; anything after it is a remote command
	# (e.g. `ssh gpu nvidia-smi`). An implicit-cpu remote command must name it
	# explicitly (`ssh cpu <cmd>`) so a mistyped target can't be run as a command.
	if [ $# -gt 0 ]; then
		case "$1" in
		cpu | gpu) role="$1"; shift ;;
		*)
			log_error "unknown target '$1' (expected: cpu | gpu)"
			usage >&2
			return 2
			;;
		esac
	fi
	_load_state_or_die || return 1
	target="$(_resolve_target "$role")" || return $?
	ip="${target%% *}"
	if [ $# -gt 0 ]; then
		# One-shot remote command (e.g. `ssh gpu nvidia-smi`).
		_ssh "$ip" "$*"
	else
		# Interactive login shell (ssh allocates a tty when no command is given).
		# Unquoted $(_ssh_opts) must word-split into flags — same as _ssh.
		# shellcheck disable=SC2046,SC2086,SC2029
		ssh $(_ssh_opts) "root@$ip"
	fi
}

cmd_logs() {
	role="cpu"; follow=0
	while [ $# -gt 0 ]; do
		case "$1" in
		cpu | gpu) role="$1"; shift ;;
		-f | --follow) follow=1; shift ;;
		*)
			log_error "unknown argument to 'logs': $1"
			usage >&2
			return 2
			;;
		esac
	done
	_load_state_or_die || return 1
	target="$(_resolve_target "$role")" || return $?
	ip="${target%% *}"; rest="${target#* }"; unit="${rest%% *}"
	if [ "$follow" -eq 1 ]; then
		_ssh "$ip" "journalctl -u $unit -f"
	else
		_ssh "$ip" "journalctl -u $unit -n 100 --no-pager"
	fi
}

# Print one node's service state + a local health probe. Best-effort: a down
# unit or failing probe is reported, not fatal, so a two-node status still runs.
_status_one() { # role
	target="$(_resolve_target "$1")" || return $?
	ip="${target%% *}"; rest="${target#* }"; unit="${rest%% *}"; health="${rest#* }"
	printf '== %s (%s @ %s) ==\n' "$1" "$unit" "$ip"
	active="$(_ssh "$ip" "systemctl is-active $unit" 2>/dev/null || true)"
	printf 'service: %s\n' "${active:-unknown}"
	if _ssh "$ip" "curl -fsS --max-time 5 $health >/dev/null" 2>/dev/null; then
		printf 'health:  ok (%s)\n' "$health"
	else
		printf 'health:  FAIL (%s)\n' "$health"
	fi
}

cmd_status() {
	role=""
	case "${1:-}" in
	cpu | gpu) role="$1"; shift ;;
	"") ;;
	*)
		log_error "unknown target '$1' (expected: cpu | gpu)"
		usage >&2
		return 2
		;;
	esac
	if [ $# -gt 0 ]; then
		log_error "unknown argument to 'status': $1"
		usage >&2
		return 2
	fi
	_load_state_or_die || return 1
	# Note the DO Project the resources are grouped under (F13, #30), when recorded.
	if [ -n "${DO_PROJECT_NAME:-}" ]; then
		log_info "resources grouped under DO Project '$DO_PROJECT_NAME'"
	fi
	# Surface the app's public HTTPS URL (F14, #31 / #36), when recorded — so it's
	# discoverable after the initial `start` without re-deriving it from the IP.
	if [ -n "${APP_URL:-}" ]; then
		log_info "app URL: $APP_URL"
	fi
	if [ -n "$role" ]; then
		_status_one "$role"
	else
		# No target → both nodes.
		_status_one cpu || return $?
		_status_one gpu || return $?
	fi
}

# --- Dispatch ----------------------------------------------------------------

main() {
	# Leading global flags, then dispatch on the first non-flag as a command.
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			return 0
			;;
		-v | --verbose)
			LOG_LEVEL=DEBUG
			shift
			;;
		--app-dir)
			# Global option (F11, #27): select the app to run/deploy. Its
			# digital-ocean.yml manifest supplies the app-specific facts.
			if [ $# -lt 2 ]; then
				log_error "--app-dir requires a directory argument"
				usage >&2
				return 2
			fi
			APP_DIR_OPT="$2"
			shift 2
			;;
		--app-dir=*)
			APP_DIR_OPT="${1#--app-dir=}"
			shift
			;;
		--env)
			# Global option (F12, #29): select the deployment environment.
			if [ $# -lt 2 ]; then
				log_error "--env requires an argument (prod|staging)"
				usage >&2
				return 2
			fi
			DEPLOY_ENV="$2"
			shift 2
			;;
		--env=*)
			DEPLOY_ENV="${1#--env=}"
			shift
			;;
		--)
			shift
			break
			;;
		-*)
			log_error "unknown argument: $1"
			usage >&2
			return 2
			;;
		*)
			break
			;;
		esac
	done

	# Validate + apply the deployment env now that flags are parsed (F12, #29).
	case "$DEPLOY_ENV" in
	prod | staging) ;;
	*)
		log_error "--env must be 'prod' or 'staging' (got '$DEPLOY_ENV')."
		usage >&2
		return 2
		;;
	esac
	_resolve_state_file

	if [ $# -eq 0 ]; then
		# No command — keep the skeleton banner (used by F1's smoke tests).
		log_info "Starting digital-ocean."
		log_debug "Log level: $LOG_LEVEL"
		echo "digital-ocean control CLI. Run with --help for usage."
		log_info "Done."
		return 0
	fi

	subcommand="$1"
	shift
	case "$subcommand" in
	setup)
		cmd_setup "$@"
		;;
	local)
		cmd_local "$@"
		;;
	start)
		cmd_start "$@"
		;;
	provision)
		cmd_provision "$@"
		;;
	stop)
		cmd_stop "$@"
		;;
	destroy)
		cmd_destroy "$@"
		;;
	ssh)
		cmd_ssh "$@"
		;;
	logs)
		cmd_logs "$@"
		;;
	status)
		cmd_status "$@"
		;;
	*)
		log_error "unknown command: $subcommand"
		usage >&2
		return 2
		;;
	esac
}

# Allow sourcing the helper functions WITHOUT executing (DO_SOURCE_ONLY=1) — used
# by the real-boundary test (tests/integration/do-provision.bats) to drive the
# ensure_* functions against live DO, and available for F7's start to reuse.
if [ -z "${DO_SOURCE_ONLY:-}" ]; then
	main "$@"
fi
